<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!--
    Drop-in replacement for web.external_layout on Servigas customer-facing PDFs.
    Mirrors web.external_layout_standard's header/article/footer structure so
    wkhtmltopdf's header-html/footer-html split (ir_actions_report._prepare_html)
    repeats the Servigas brand on every page of multi-page documents, instead of
    printing it once inside a single scrolling div.
    Honors address / information_block / layout_document_title like external_layout_standard,
    but brands with the Servigas mark instead of company.external_report_layout.
  -->
  <template id="report_servigas_layout">
    <t t-if="not o" t-set="o" t-value="doc"/>
    <t t-if="not company">
      <t t-if="company_id">
        <t t-set="company" t-value="company_id"/>
      </t>
      <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
        <t t-set="company" t-value="o.company_id.sudo()"/>
      </t>
      <t t-else="">
        <t t-set="company" t-value="res_company"/>
      </t>
    </t>

    <div class="header sg-report-header" style="font-family: DejaVu Sans, sans-serif; color: #1a1a1a;">
      <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
      <div style="display:flex; align-items:center; gap:16px; border-bottom:2px solid #c45c26; padding-bottom:12px;">
        <t t-set="sg_mark" t-value="env['report.servigas.brand'].get_mark_src()"/>
        <img t-if="sg_mark"
             t-att-src="sg_mark"
             style="height:56px; width:auto;"
             alt="Servigas"/>
        <div style="flex:1;">
          <div style="font-size:18px; font-weight:700; line-height:1.3;"
               t-out="layout_document_title"/>
        </div>
        <div style="text-align:right; font-size:10px; color:#555; line-height:1.4; white-space:nowrap;">
          <div t-esc="company.name"/>
          <div t-if="not forced_vat and company.vat">
            <t t-esc="company.country_id.vat_label or 'CUIT'"/>: <span t-esc="company.vat"/>
          </div>
          <div t-elif="forced_vat">
            <t t-esc="company.country_id.vat_label or 'CUIT'"/>: <span t-esc="forced_vat"/>
          </div>
        </div>
      </div>
    </div>

    <div class="article o_report_layout_standard o_table_standard sg-report-article"
         t-att-data-oe-model="o and o._name"
         t-att-data-oe-id="o and o.id"
         t-att-data-oe-lang="o and o.env.context.get('lang')"
         style="font-family: DejaVu Sans, sans-serif; color: #1a1a1a; font-size: 12px;">
      <t t-call="web.address_layout"/>
      <t t-out="0"/>
    </div>

    <div class="footer sg-report-footer" style="font-family: DejaVu Sans, sans-serif; color: #888; font-size: 11px;">
      <div style="display:flex; justify-content:space-between; border-top:1px solid #ddd; padding-top:8px;">
        <span>Servigas</span>
        <span t-if="report_type == 'pdf'">P&#225;gina <span class="page"/> / <span class="topage"/></span>
      </div>
    </div>
  </template>
</odoo>
