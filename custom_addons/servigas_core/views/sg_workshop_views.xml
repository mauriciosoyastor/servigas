<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sg_appliance_tree" model="ir.ui.view">
        <field name="name">sg.appliance.list</field>
        <field name="model">sg.appliance</field>
        <field name="arch" type="xml">
            <list>
                <field name="serial_number"/>
                <field name="brand"/>
                <field name="model"/>
                <field name="name"/>
                <field name="gas_type"/>
                <field name="work_order_count"/>
                <field name="partner_id"/>
            </list>
        </field>
    </record>
    <record id="view_sg_appliance_form" model="ir.ui.view">
        <field name="name">sg.appliance.form</field>
        <field name="model">sg.appliance</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="serial_number"/>
                        <field name="brand"/>
                        <field name="model"/>
                        <field name="name"/>
                        <field name="gas_type"/>
                        <field name="partner_id"/>
                    </group>
                    <field name="work_order_ids">
                        <list>
                            <field name="date"/>
                            <field name="name"/>
                            <field name="owner_name"/>
                            <field name="state"/>
                            <field name="amount"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_sg_appliance" model="ir.actions.act_window">
        <field name="name">Artefactos</field>
        <field name="res_model">sg.appliance</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_sg_work_order_tree" model="ir.ui.view">
        <field name="name">sg.work.order.list</field>
        <field name="model">sg.work.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="name"/>
                <field name="serial_number"/>
                <field name="owner_name"/>
                <field name="owner_phone"/>
                <field name="amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_sg_work_order_form" model="ir.ui.view">
        <field name="name">sg.work.order.form</field>
        <field name="model">sg.work.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_done" type="object" string="Cerrar" invisible="state == 'done'"/>
                    <button name="action_draft" type="object" string="Volver a borrador" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="date"/>
                        <field name="appliance_id"/>
                        <field name="owner_name"/>
                        <field name="owner_phone"/>
                        <field name="partner_id"/>
                        <field name="amount"/>
                    </group>
                    <group>
                        <field name="problem"/>
                        <field name="observation"/>
                        <field name="work_done"/>
                        <field name="materials"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_sg_work_order" model="ir.actions.act_window">
        <field name="name">Órdenes de trabajo</field>
        <field name="res_model">sg.work.order</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_sg_work_order_new" model="ir.actions.act_window">
        <field name="name">Nueva orden</field>
        <field name="res_model">sg.work.order</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_state': 'draft'}</field>
    </record>
</odoo>
