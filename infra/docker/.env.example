# Copiá a .env y ajustá si hace falta:
#   copy .env.example .env

# DB interna del compose (no uses el Postgres de Windows)
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo

# Nombre de la base Odoo (crear/instalar módulos la primera vez)
ODOO_DB=servigas

# Puertos en el HOST (evitar choque con nativo: Odoo 8070 / Astro 4321 / PG 5432)
DB_HOST_PORT=5433
ODOO_HOST_PORT=8069
WEB_HOST_PORT=4322
