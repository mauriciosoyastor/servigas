---
import OrderCreateForm from '../../../../components/OrderCreateForm.astro';
import ShellLayout from '../../../../layouts/ShellLayout.astro';
import { invalidateBffSession, requireOdooSession } from '../../../../lib/bff/http.ts';

let userName = '';

try {
	const { session } = requireOdooSession(Astro.cookies);
	userName = session.name || session.login;
} catch {
	invalidateBffSession(Astro.cookies);
	return Astro.redirect('/login');
}
---

<ShellLayout title="Cargar factura de proveedor | Servigas" active="accounting" userName={userName}>
	<main class="sg-create-page">
		<header>
			<p>Cobros</p>
			<h1>Cargar factura de proveedor</h1>
		</header>
		<OrderCreateForm
			apiPath="/api/records/accounting/vendor-bills"
			listPath="/lists/accounting/vendor-bills"
			partnerListKey="purchase/vendors"
			productListKey="inventory/variants"
			title="Alta de FP"
			hint="Adjuntá el PDF o la foto que llegó por WhatsApp o mail, elegí proveedor y líneas. Queda en borrador; publicá desde la ficha."
			partnerLabel="Proveedor"
			partnerPlaceholder="Buscar proveedor…"
			submitLabel="Crear borrador"
			requireAttachment={true}
			showBillSource={true}
			suppressFiscalHints={true}
		/>
	</main>
</ShellLayout>

