---
import RecordConfirmControl from '../../../../components/RecordConfirmControl.astro';
import RecordDetailBody from '../../../../components/RecordDetailBody.astro';
import RecordInvoicePdfControl from '../../../../components/RecordInvoicePdfControl.astro';
import RecordMarkFwLoadedControl from '../../../../components/RecordMarkFwLoadedControl.astro';
import RecordRegisterPaymentControl from '../../../../components/RecordRegisterPaymentControl.astro';
import ShellLayout from '../../../../layouts/ShellLayout.astro';
import { isFwMarkableState } from '../../../../lib/shell/fw-bridge.ts';
import { isInvoiceLifecycleReady } from '../../../../lib/shell/invoice-lifecycle.ts';
import { loadRecordDetail } from '../../../../lib/shell/load-record-detail.ts';
import { isPaymentRegisterableState } from '../../../../lib/shell/payment-registers.ts';
import { isConfirmableState } from '../../../../lib/shell/record-actions.ts';

const id = Number(Astro.params.id);
const loaded = await loadRecordDetail(
	Astro.cookies,
	'accounting/customer-invoices',
	id,
	'No encontramos esta factura.'
);
if (loaded.kind === 'redirect') {
	return Astro.redirect(loaded.path);
}
if (loaded.status) Astro.response.status = loaded.status;
const { userName, detail, error } = loaded;

function fieldValue(key: string): string {
	const hit = detail?.fields.find((field) => field.key === key);
	if (hit?.value === null || hit?.value === undefined) return '';
	return String(hit.value);
}

const state = fieldValue('state');
const paymentState = fieldValue('payment_state');
const residual = fieldValue('amount_residual');
const fwLoaded = fieldValue('sg_fw_loaded');
const showPublish = isConfirmableState('accounting/customer-invoices', state);
const showPay = isPaymentRegisterableState(state, paymentState);
const showMarkFw = isFwMarkableState(state, fwLoaded);
const showResetCancel = isInvoiceLifecycleReady(state, paymentState);
---

<ShellLayout title={`${detail?.title || 'Factura'} | Servigas`} active="accounting" userName={userName}>
	<RecordDetailBody
		detail={detail}
		error={error}
		eyebrow="Ficha de factura"
		fallbackTitle="Factura de cliente"
		fallbackListPath="/lists/accounting/customer-invoices"
		recordId={id}
	>
		<div slot="secondary" class="sg-ficha-secondary-actions">
			{detail && !error ? (
				<RecordInvoicePdfControl
					listKey="accounting/customer-invoices"
					recordId={id}
					title={detail.title}
				/>
			) : null}
			{detail && !error && showPublish ? (
				<a
					class="sg-ficha-action sg-focus-ring"
					href={`/lists/accounting/customer-invoices/${id}/edit`}
				>
					Editar borrador
				</a>
			) : null}
			{detail && !error && showPublish ? (
				<RecordConfirmControl
					listKey="accounting/customer-invoices"
					recordId={id}
					apiPath="/api/records/accounting/customer-invoices"
					label="Publicar"
					confirmMessage="¿Publicar esta factura de cliente?"
					pendingLabel="Publicando…"
					okLabel="Publicada"
				/>
			) : null}
			{detail && !error && showPay ? (
				<RecordRegisterPaymentControl
					listKey="accounting/customer-invoices"
					recordId={id}
					apiPath="/api/records/accounting/customer-invoices"
					defaultAmount={residual}
					label="Registrar cobro"
					directionLabel="cobro"
					defaultPaymentMethod="cash"
				/>
			) : null}
			{detail && !error && showResetCancel ? (
				<RecordConfirmControl
					listKey="accounting/customer-invoices"
					recordId={id}
					apiPath="/api/records/accounting/customer-invoices"
					action="reset_invoice_draft"
					label="Volver a borrador"
					confirmMessage="¿Volver esta factura a borrador?"
					pendingLabel="Revirtiendo…"
					okLabel="En borrador"
				/>
			) : null}
			{detail && !error && showResetCancel ? (
				<RecordConfirmControl
					listKey="accounting/customer-invoices"
					recordId={id}
					apiPath="/api/records/accounting/customer-invoices"
					action="cancel_invoice"
					label="Anular"
					confirmMessage="¿Anular esta factura? Esta acción no se deshace desde aquí."
					pendingLabel="Anulando…"
					okLabel="Anulada"
				/>
			) : null}
			{detail && !error && showMarkFw ? (
				<RecordMarkFwLoadedControl
					listKey="accounting/customer-invoices"
					recordId={id}
					apiPath="/api/records/accounting/customer-invoices"
				/>
			) : null}
		</div>
	</RecordDetailBody>
</ShellLayout>
