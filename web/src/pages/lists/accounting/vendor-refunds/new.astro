---
import OrderCreateForm from '../../../../components/OrderCreateForm.astro';
import ShellLayout from '../../../../layouts/ShellLayout.astro';
import { invalidateBffSession, requireOdooSession } from '../../../../lib/bff/http.ts';

let userName = '';

try {
	const { session } = requireOdooSession(Astro.cookies);
	userName = session.name || session.login;
} catch {
	invalidateBffSession(Astro.cookies);
	return Astro.redirect('/login');
}
---

<ShellLayout title="Nueva nota de crédito proveedor | Servigas" active="accounting" userName={userName}>
	<main class="sg-create-page">
		<header>
			<p>Cobros</p>
			<h1>Nueva nota de crédito de proveedor</h1>
		</header>
		<OrderCreateForm
			apiPath="/api/records/accounting/vendor-refunds"
			listPath="/lists/accounting/vendor-refunds"
			partnerListKey="purchase/vendors"
			productListKey="inventory/variants"
			title="Alta de nota de crédito proveedor"
			hint="Elegí proveedor y líneas. Queda en borrador; publicá desde la ficha."
			partnerLabel="Proveedor"
			partnerPlaceholder="Buscar proveedor…"
			submitLabel="Crear borrador"
		/>
	</main>
</ShellLayout>

