---
import ShellLayout from '../../layouts/ShellLayout.astro';
import FwBulkMarkBar from '../../components/FwBulkMarkBar.astro';
import InvoicePdfModalHost from '../../components/InvoicePdfModalHost.astro';
import ProductImageUploadHost from '../../components/ProductImageUploadHost.astro';
import ProductRowDeleteHost from '../../components/ProductRowDeleteHost.astro';
import RecordTable from '../../components/RecordTable.astro';
import ListToolbar from '../../components/ListToolbar.astro';
import { BffError } from '../../lib/bff/errors.ts';
import { getBackend } from '../../lib/bff/get-backend.ts';
import { invalidateBffSession, requireOdooSession } from '../../lib/bff/http.ts';
import type { RecordListPayload } from '../../lib/bff/types.ts';
import { canFetchInvoicePdf } from '../../lib/shell/invoice-pdf.ts';
import {
	getRecordListDef,
	parsePositiveIntParam,
	resolveRecordListKey,
} from '../../lib/shell/record-lists.ts';
import { canCreateRecord } from '../../lib/shell/record-writes.ts';

const slugParts = Array.isArray(Astro.params.slug)
	? Astro.params.slug
	: String(Astro.params.slug || '')
			.split('/')
			.filter(Boolean);

const rawListKey = slugParts.join('/');
const resolvedKey = resolveRecordListKey(rawListKey);
if (resolvedKey && resolvedKey !== rawListKey) {
	return Astro.redirect(`/lists/${resolvedKey}${Astro.url.search}`);
}

const listKey = resolvedKey || rawListKey;
const def = getRecordListDef(listKey);
const createPath = canCreateRecord(listKey) ? `${def?.path}/new` : null;
const createLabel =
	listKey === 'sales/customers'
		? 'Nuevo cliente'
		: listKey === 'purchase/vendors'
			? 'Nuevo proveedor'
			: listKey === 'inventory/products'
				? 'Nuevo producto'
				: listKey === 'inventory/categories'
					? 'Nueva categoría'
				: listKey === 'sales/quotations'
					? 'Nueva cotización'
					: listKey === 'purchase/solicitudes'
						? 'Nuevo pedido a proveedor'
						: listKey === 'accounting/customer-invoices'
							? 'Nueva factura'
							: listKey === 'accounting/credit-notes'
								? 'Nueva nota de crédito'
								: listKey === 'accounting/vendor-bills'
									? 'Cargar factura de proveedor'
									: listKey === 'accounting/vendor-refunds'
										? 'Nueva nota de crédito proveedor'
										: listKey === 'workshop/orders' ||
											  listKey === 'workshop/orders-draft'
											? 'Nueva OT'
											: 'Nuevo';

const showFwExport = listKey === 'accounting/factura-web-pending';
const showFwBulk = listKey === 'accounting/factura-web-pending';

let userName = '';
let listError = '';
let payload: RecordListPayload | null = null;
let categoryFilterName = '';
let partnerFilterName = '';
const q = Astro.url.searchParams.get('q') || '';
const page = Number(Astro.url.searchParams.get('page') || '1') || 1;
const categId =
	listKey === 'inventory/products'
		? parsePositiveIntParam(Astro.url.searchParams.get('categ_id'))
		: undefined;
const partnerId =
	listKey === 'inventory/products'
		? parsePositiveIntParam(Astro.url.searchParams.get('partner_id'))
		: undefined;

if (!def) {
	Astro.response.status = 404;
} else {
	try {
		const { session, odooSessionId } = requireOdooSession(Astro.cookies);
		userName = session.name || session.login;
		try {
			payload = await getBackend().getRecordList(odooSessionId, listKey, {
				q,
				page,
				categId,
				partnerId,
			});
			if (categId) {
				try {
					const category = await getBackend().getRecordDetail(
						odooSessionId,
						'inventory/categories',
						categId
					);
					categoryFilterName = String(category?.title || '').trim();
				} catch {
					categoryFilterName = '';
				}
			}
			if (partnerId) {
				try {
					const partner = await getBackend().getRecordDetail(
						odooSessionId,
						'purchase/vendors',
						partnerId
					);
					partnerFilterName = String(partner?.title || '').trim();
				} catch {
					partnerFilterName = '';
				}
			}
		} catch (cause) {
			if (cause instanceof BffError && cause.code === 'unauthorized') {
				invalidateBffSession(Astro.cookies);
				return Astro.redirect('/login');
			}
			listError = 'No pudimos cargar el listado. Intentá nuevamente en unos minutos.';
		}
	} catch {
		invalidateBffSession(Astro.cookies);
		return Astro.redirect('/login');
	}
}
---

{def ? (
	<ShellLayout title={`${payload?.title || def.title} | Servigas`} active={def.railApp} userName={userName}>
		<main class="sg-list-page">
			<header class="sg-list-heading">
				<div>
					<p>{payload?.hint || def.hint}</p>
					<h1>{payload?.title || def.title}</h1>
				</div>
				<div class="sg-list-heading-meta">
					{payload ? (
						<span>
							{payload.total.toLocaleString('es-AR')} registros
							{payload.rows.length < payload.total
								? ` · página ${payload.page}`
								: ''}
						</span>
					) : null}
					{createPath ? (
						<a class="sg-list-create sg-focus-ring" href={createPath}>{createLabel}</a>
					) : null}
					{listKey === 'inventory/products' ? (
						<a class="sg-list-create sg-focus-ring" href="/lists/inventory/products/import">
							Cargar lista de precios/Productos
						</a>
					) : null}
					{showFwExport ? (
						<a
							class="sg-list-create sg-focus-ring"
							href="/api/accounting/factura-web-export"
							download
						>
							Exportar CSV
						</a>
					) : null}
					{listKey === 'accounting/factura-web' ? (
						<a
							class="sg-list-create sg-focus-ring"
							href="/lists/accounting/factura-web-pending"
						>
							Ver pendientes
						</a>
					) : null}
					<a class="sg-list-back sg-focus-ring" href={def.hubBack}>← Volver</a>
				</div>
			</header>

			{categId || partnerId ? (
				<section class="sg-list-filter-banner sg-glass" aria-live="polite">
					<p>
						{(() => {
							const parts: string[] = [];
							if (categId) {
								parts.push(
									categoryFilterName
										? `categoría «${categoryFilterName}»`
										: 'categoría'
								);
							}
							if (partnerId) {
								parts.push(
									partnerFilterName
										? `proveedor «${partnerFilterName}»`
										: 'proveedor'
								);
							}
							return `Productos filtrados por ${parts.join(' y ')}`;
						})()}
					</p>
					<a class="sg-focus-ring" href="/lists/inventory/products">Quitar filtro</a>
				</section>
			) : null}

			{payload ? (
				<ListToolbar
					action={def.path}
					q={payload.q}
					page={payload.page}
					pageSize={payload.pageSize}
					total={payload.total}
					categId={categId}
					partnerId={partnerId}
				/>
			) : null}

			{listError ? (
				<section class="sg-list-state sg-glass" role="alert">
					<strong>No se pudo abrir el listado</strong>
					<p>{listError}</p>
				</section>
			) : payload && payload.rows.length ? (
				<>
					{showFwBulk ? (
						<FwBulkMarkBar
							listKey={listKey}
							apiPath={`/api/records/${listKey}`}
						/>
					) : null}
					<RecordTable
						columns={payload.columns}
						rows={payload.rows}
						caption={payload.title}
						imageUploadApiPath={
							listKey === 'inventory/products'
								? '/api/records/inventory/products'
								: undefined
						}
						rowDeleteApiPath={
							listKey === 'inventory/products'
								? '/api/records/inventory/products'
								: undefined
						}
						invoicePdfListKey={
							canFetchInvoicePdf(listKey) ? listKey : undefined
						}
						rowSelect={showFwBulk}
						fwNumberInput={showFwBulk}
					/>
					<ListToolbar
						action={def.path}
						q={payload.q}
						page={payload.page}
						pageSize={payload.pageSize}
						total={payload.total}
						categId={categId}
						partnerId={partnerId}
					/>
					{listKey === 'inventory/products' ? <ProductImageUploadHost /> : null}
					{listKey === 'inventory/products' ? <ProductRowDeleteHost /> : null}
					{canFetchInvoicePdf(listKey) ? <InvoicePdfModalHost /> : null}
				</>
			) : (
				<section class="sg-list-state sg-glass">
					<strong>Sin resultados</strong>
					<p>
						{payload?.q
							? 'No hay registros que coincidan con la búsqueda.'
							: partnerId && categId
								? 'No hay productos activos para este proveedor en esta categoría.'
								: partnerId
									? 'No hay productos activos para este proveedor.'
									: categId
										? 'No hay productos activos en esta categoría.'
										: 'No encontramos registros para mostrar.'}
					</p>
				</section>
			)}
		</main>
	</ShellLayout>
) : (
	<h1>Lista no encontrada</h1>
)}

<style>
	.sg-list-page {
		max-width: 78rem;
		margin: 0 auto;
	}
	.sg-list-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.5rem;
		flex-wrap: wrap;
	}
	.sg-list-heading p {
		margin: 0 0 0.5rem;
		color: var(--sg-text-muted-dark);
		font-size: 0.78rem;
		font-weight: 500;
	}
	.sg-list-heading h1 {
		margin: 0;
		font-size: clamp(2rem, 4vw, 3.2rem);
		font-weight: 600;
		letter-spacing: -0.045em;
		line-height: 1.05;
	}
	.sg-list-heading-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
	}
	.sg-list-heading-meta > span {
		border: 1px solid var(--sg-glass-border);
		border-radius: var(--sg-radius-pill);
		padding: 0.55rem 0.8rem;
		color: var(--sg-text-muted-dark);
		background: var(--sg-glass-fill);
		font-size: 0.7rem;
		font-weight: 600;
	}
	.sg-list-back,
	.sg-list-create {
		border: 1px solid var(--sg-glass-border);
		border-radius: var(--sg-radius-pill);
		padding: 0.55rem 0.9rem;
		color: var(--sg-text-on-dark);
		background: var(--sg-glass-fill);
		font-size: 0.8rem;
		font-weight: 600;
		text-decoration: none;
	}
	.sg-list-create {
		border-color: rgba(155, 231, 176, 0.45);
	}
	.sg-list-state {
		border-radius: var(--sg-radius-card);
		padding: 2rem;
	}
	.sg-list-state strong {
		font-size: 1.1rem;
	}
	.sg-list-state p {
		margin: 0.55rem 0 0;
		color: var(--sg-text-muted-dark);
		font-size: 0.88rem;
	}
	.sg-list-filter-banner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-bottom: 1rem;
		padding: 0.85rem 1rem;
		border-radius: var(--sg-radius-card);
	}
	.sg-list-filter-banner p {
		margin: 0;
		font-size: 0.88rem;
		font-weight: 600;
	}
	.sg-list-filter-banner a {
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--sg-text-on-dark);
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}
</style>
