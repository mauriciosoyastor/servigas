---
import RecordConfirmControl from '../../../../components/RecordConfirmControl.astro';
import RecordDetailBody from '../../../../components/RecordDetailBody.astro';
import RecordNotes from '../../../../components/RecordNotes.astro';
import RecordSaleOrderShareControl from '../../../../components/RecordSaleOrderShareControl.astro';
import ShellLayout from '../../../../layouts/ShellLayout.astro';
import { getBackend } from '../../../../lib/bff/get-backend.ts';
import { requireOdooSession } from '../../../../lib/bff/http.ts';
import { loadRecordDetail } from '../../../../lib/shell/load-record-detail.ts';
import { isConfirmableState } from '../../../../lib/shell/record-actions.ts';
import {
	missingCustomerContactHint,
	saleOrderDocumentLabel,
	saleOrderPdfPath,
	type SaleOrderShareMeta,
} from '../../../../lib/shell/sale-order-share.ts';

const listKey = 'sales/quotations';
const id = Number(Astro.params.id);
const loaded = await loadRecordDetail(
	Astro.cookies,
	listKey,
	id,
	'No encontramos esta cotización.'
);
if (loaded.kind === 'redirect') {
	return Astro.redirect(loaded.path);
}
if (loaded.status) Astro.response.status = loaded.status;
const { userName, detail, error } = loaded;

function fieldValue(key: string): string {
	const hit = detail?.fields.find((field) => field.key === key);
	if (hit?.value === null || hit?.value === undefined) return '';
	return String(hit.value);
}

const state = fieldValue('state');
const showConfirm = isConfirmableState(listKey, state);

const pdfPath = saleOrderPdfPath(listKey, id);
const fallbackShare: SaleOrderShareMeta = {
	orderName: detail?.title || `S-${id}`,
	partnerName: fieldValue('partner_id') || 'Cliente',
	email: null,
	phone: null,
	whatsappUrl: null,
	pdfPath,
	missingContactHint: missingCustomerContactHint({ phone: null, email: null }),
	documentLabel: saleOrderDocumentLabel(listKey),
};

let share: SaleOrderShareMeta | null = pdfPath ? fallbackShare : null;
if (detail && !error && share) {
	try {
		const { odooSessionId } = requireOdooSession(Astro.cookies);
		share = await getBackend().getSaleOrderShareMeta(odooSessionId, listKey, id);
	} catch (cause) {
		console.warn('[sales/quotations] share meta fallback', cause);
		share = fallbackShare;
	}
}
---

<ShellLayout title={`${detail?.title || 'Cotización'} | Servigas`} active="sales" userName={userName}>
	<RecordDetailBody
		detail={detail}
		error={error}
		eyebrow="Ficha de cotización"
		fallbackTitle="Cotización"
		fallbackListPath="/lists/sales/quotations"
		recordId={id}
	>
		{detail && !error ? (
			<div slot="secondary">
				{share ? (
					<RecordSaleOrderShareControl
						listKey={listKey}
						recordId={id}
						share={share}
					/>
				) : null}
				{showConfirm ? (
					<RecordConfirmControl
						listKey={listKey}
						recordId={id}
						apiPath="/api/records/sales/quotations"
						label="Confirmar pedido"
					/>
				) : null}
			</div>
		) : null}
		{detail && !error ? (
			<RecordNotes slot="notes" listKey={listKey} recordId={id} />
		) : null}
	</RecordDetailBody>
</ShellLayout>
