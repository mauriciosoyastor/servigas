---
import RecordCreateForm from '../../../../components/RecordCreateForm.astro';
import ShellLayout from '../../../../layouts/ShellLayout.astro';
import { invalidateBffSession, requireOdooSession } from '../../../../lib/bff/http.ts';
import { INVOICE_DEST_OPTIONS } from '../../../../lib/shell/invoice-dest.ts';

let userName = '';
try {
	const { session } = requireOdooSession(Astro.cookies);
	userName = session.name || session.login;
} catch {
	invalidateBffSession(Astro.cookies);
	return Astro.redirect('/login');
}
---

<ShellLayout title="Nuevo cliente | Servigas" active="customers" userName={userName}>
	<main class="sg-create-page">
		<header>
			<p>Clientes</p>
			<h1>Nuevo cliente</h1>
		</header>
		<RecordCreateForm
			listKey="sales/customers"
			apiPath="/api/records/sales/customers"
			listPath="/lists/sales/customers"
			title="Alta de cliente"
			hint="Elegí destino fiscal: Consumidor final o Con CUIT. Si es Con CUIT, el CUIT es obligatorio."
			fields={[
				{
					key: 'name',
					label: 'Nombre',
					required: true,
					placeholder: 'Nombre o razón social',
				},
				{
					key: 'sg_invoice_dest',
					label: 'Factura como',
					required: true,
					type: 'select',
					options: [...INVOICE_DEST_OPTIONS],
				},
				{ key: 'vat', label: 'CUIT', placeholder: '20-12345678-6' },
				{
					key: 'phone',
					label: 'Teléfono',
					type: 'tel',
					placeholder: '351 555 1234',
				},
				{
					key: 'email',
					label: 'Email',
					type: 'email',
					placeholder: 'correo@ejemplo.com',
				},
				{
					key: 'street',
					label: 'Calle',
					placeholder: 'Calle y número',
					wide: true,
				},
				{ key: 'city', label: 'Ciudad', placeholder: 'Ciudad' },
			]}
		/>
	</main>
</ShellLayout>
