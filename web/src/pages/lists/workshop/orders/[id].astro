---
import RecordArchiveControl from '../../../../components/RecordArchiveControl.astro';
import RecordConfirmControl from '../../../../components/RecordConfirmControl.astro';
import RecordDetailBody from '../../../../components/RecordDetailBody.astro';
import RecordWorkOrderCashControl from '../../../../components/RecordWorkOrderCashControl.astro';
import RecordWorkOrderShareControl from '../../../../components/RecordWorkOrderShareControl.astro';
import ShellLayout from '../../../../layouts/ShellLayout.astro';
import { getBackend } from '../../../../lib/bff/get-backend.ts';
import { requireOdooSession } from '../../../../lib/bff/http.ts';
import { loadRecordDetail } from '../../../../lib/shell/load-record-detail.ts';
import { isConfirmableState } from '../../../../lib/shell/record-actions.ts';
import {
	missingWorkshopContactHint,
	workshopOrderPdfPath,
	type WorkshopOrderShareMeta,
} from '../../../../lib/shell/workshop-order-share.ts';
import {
	canRegisterWorkOrderCash,
	workOrderCashRemaining,
} from '../../../../lib/shell/workshop-order-cash.ts';
import { parseArs } from '../../../../lib/money/ars.ts';

const listKey = 'workshop/orders';
const id = Number(Astro.params.id);
const loaded = await loadRecordDetail(
	Astro.cookies,
	listKey,
	id,
	'No encontramos esta orden de trabajo.'
);
if (loaded.kind === 'redirect') {
	return Astro.redirect(loaded.path);
}
if (loaded.status) Astro.response.status = loaded.status;
const { userName, detail, error } = loaded;

function fieldValue(key: string): string {
	const hit = detail?.fields.find((field) => field.key === key);
	if (hit?.value === null || hit?.value === undefined) return '';
	return String(hit.value);
}

function moneyField(key: string): number {
	const raw = fieldValue(key);
	if (!raw) return 0;
	const parsed = parseArs(raw);
	if (parsed != null) return parsed;
	const n = Number(String(raw).replace(',', '.'));
	return Number.isFinite(n) ? n : 0;
}

const state = fieldValue('state');
const showClose = isConfirmableState(listKey, state);
const applianceId = Number(fieldValue('appliance_ref_id')) || 0;
const amountNum = moneyField('amount');
const depositNum = moneyField('deposit');
const collectedNum = moneyField('amount_collected');
const remaining = workOrderCashRemaining(amountNum, collectedNum, depositNum);
const fullyCollected = !canRegisterWorkOrderCash(
	amountNum,
	collectedNum,
	remaining == null ? 1 : Math.max(remaining, 0.01),
	depositNum
);
const defaultCashAmount =
	remaining != null && remaining > 0 ? remaining : '';

const pdfPath = workshopOrderPdfPath(listKey, id);
const fallbackShare: WorkshopOrderShareMeta = {
	orderName: detail?.title || `OT-${id}`,
	displayName: fieldValue('owner_name') || fieldValue('partner_id') || 'cliente',
	email: null,
	phone: null,
	whatsappUrl: null,
	pdfPath,
	missingContactHint: missingWorkshopContactHint({ phone: null, email: null }),
};
let share: WorkshopOrderShareMeta | null = pdfPath ? fallbackShare : null;
if (detail && !error && share) {
	try {
		const { odooSessionId } = requireOdooSession(Astro.cookies);
		share = await getBackend().getWorkshopOrderShareMeta(odooSessionId, listKey, id);
	} catch (cause) {
		console.warn('[workshop/orders] share meta fallback', cause);
		share = fallbackShare;
	}
}
---

<ShellLayout title={`${detail?.title || 'OT'} | Servigas`} active="workshop" userName={userName}>
	<RecordDetailBody
		detail={detail}
		error={error}
		eyebrow="Ficha de orden de trabajo"
		fallbackTitle="Orden de trabajo"
		fallbackListPath="/lists/workshop/orders"
		recordId={id}
		listKey={listKey}
		editApiPath="/api/records/workshop/orders"
		editFields={
			detail && !error
				? [
						{ key: 'owner_name', label: 'Propietario', value: fieldValue('owner_name') },
						{ key: 'owner_phone', label: 'Celular', value: fieldValue('owner_phone') },
						{ key: 'problem', label: 'Problema', value: fieldValue('problem') },
						{ key: 'observation', label: 'Observación', value: fieldValue('observation') },
						{ key: 'work_done', label: 'Trabajos', value: fieldValue('work_done') },
						{ key: 'materials', label: 'Materiales', value: fieldValue('materials') },
						{ key: 'amount', label: 'Importe', value: fieldValue('amount') },
						{ key: 'deposit', label: 'Seña', value: fieldValue('deposit') },
					]
				: []
		}
	>
		{detail && !error ? (
			<div class="sg-ficha-secondary-actions" data-wo-share-panel slot="secondary">
				<div class="sg-wo-detail-brand">
					<img
						class="sg-wo-detail-mark"
						src="/servigas-mark.png?v=2"
						alt=""
						width="40"
						height="40"
						decoding="async"
					/>
				</div>
				{share ? (
					<RecordWorkOrderShareControl listKey={listKey} recordId={id} share={share} />
				) : null}
				<RecordWorkOrderCashControl
					listKey={listKey}
					recordId={id}
					defaultAmount={defaultCashAmount}
					orderName={detail.title || `OT-${id}`}
					amountCollected={collectedNum}
					remaining={remaining}
					fullyCollected={fullyCollected}
				/>
				{applianceId > 0 ? (
					<a
						class="sg-ficha-action sg-focus-ring"
						href={`/lists/workshop/appliances/${applianceId}`}
					>
						Ver artefacto
					</a>
				) : (
					<a class="sg-ficha-action sg-focus-ring" href="/lists/workshop/appliances">
						Ver artefactos
					</a>
				)}
				{showClose ? (
					<RecordConfirmControl
						listKey={listKey}
						recordId={id}
						apiPath="/api/records/workshop/orders"
						label="Cerrar orden"
					/>
				) : null}
				<RecordArchiveControl
					listKey={listKey}
					recordId={id}
					apiPath="/api/records/workshop/orders"
					listPath="/lists/workshop/orders"
					action="delete"
					label="Eliminar orden"
					confirmMessage="¿Eliminar esta orden de trabajo? No se puede deshacer."
				/>
			</div>
		) : null}
	</RecordDetailBody>
</ShellLayout>

<style>
	.sg-wo-detail-brand {
		display: flex;
		align-items: center;
		margin-bottom: 0.75rem;
	}
	.sg-wo-detail-mark {
		display: block;
		width: 2.5rem;
		height: auto;
		object-fit: contain;
	}
</style>
