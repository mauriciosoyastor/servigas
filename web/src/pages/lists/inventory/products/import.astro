---
import ShellLayout from '../../../../layouts/ShellLayout.astro';
import { invalidateBffSession, requireOdooSession } from '../../../../lib/bff/http.ts';
import {
	labelImportReason,
	labelImportStatus,
	MAPPING_FIELD_LABELS,
	MAPPING_UI_FIELDS,
} from '../../../../lib/shell/price-list-import.ts';

let userName = '';
try {
	const { session } = requireOdooSession(Astro.cookies);
	userName = session.name || session.login;
} catch {
	invalidateBffSession(Astro.cookies);
	return Astro.redirect('/login');
}

const statusLabels = Object.fromEntries(
	(['create', 'update', 'review', 'error'] as const).map((key) => [
		key,
		labelImportStatus(key),
	])
);
const reasonLabels = Object.fromEntries(
	(
		[
			'no_match',
			'barcode',
			'default_code',
			'name',
			'ambiguous_barcode',
			'ambiguous_code',
			'ambiguous_name',
			'invalid_price',
			'missing_name',
		] as const
	).map((key) => [key, labelImportReason(key)])
);
const mappingFieldLabels = MAPPING_FIELD_LABELS;
const mappingUiFields = MAPPING_UI_FIELDS;
const requiredMappingFields = ['name'];
const priceMappingFields = ['list_price', 'standard_price'];
---

<ShellLayout title="Cargar lista de precios/Productos | Servigas" active="inventory" userName={userName}>
	<main class="sg-import-page" data-price-import>
		<header>
			<p>Stock · Productos</p>
			<h1>Cargar lista de precios/Productos</h1>
			<p class="sg-import-lead">
				Subí un Excel (.xlsx / .xls) o CSV para crear productos nuevos y actualizar precio de venta y costo.
				Podés incluir columnas <code>categoria</code> (tipo) y <code>proveedor</code>.
				PDF e imágenes no están soportados: convertí a Excel o CSV primero.
			</p>
		</header>

		<section class="sg-import-card sg-glass" data-step="upload">
			<strong>1. Archivo</strong>
			<div class="sg-import-actions">
				<button type="button" class="sg-focus-ring" data-download-template>Descargar plantilla</button>
				<label class="sg-import-file sg-focus-ring">
					<span>Elegir Excel o CSV</span>
					<input
						type="file"
						accept=".csv,.xlsx,.xls,text/csv,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
						data-file-input
					/>
				</label>
			</div>
			<p class="sg-import-status" data-status hidden></p>
		</section>

		<section class="sg-import-card sg-glass" data-step="mapping" hidden>
			<strong>2. Columnas</strong>
			<p class="sg-import-lead sg-import-map-lead">
				No reconocimos todas las columnas automáticamente. Elegí qué columna del archivo
				corresponde a cada campo. <strong>Nombre</strong> y al menos un <strong>precio</strong> son obligatorios.
			</p>
			<p class="sg-import-map-meta" data-map-meta hidden></p>
			<div class="sg-import-map-grid" data-mapping-fields></div>
			<div class="sg-import-actions">
				<button type="button" class="sg-focus-ring sg-import-primary" data-confirm-mapping>
					Ver preview
				</button>
				<button type="button" class="sg-focus-ring" data-back-upload>Volver al archivo</button>
			</div>
		</section>

		<section class="sg-import-card sg-glass" data-step="preview" hidden>
			<strong>3. Preview</strong>
			<p class="sg-import-counts" data-counts></p>
			<p class="sg-import-error-banner" data-import-error-banner hidden role="status"></p>
			<div class="sg-import-table-wrap">
				<table class="sg-import-table">
					<thead>
						<tr>
							<th>OK</th>
							<th>#</th>
							<th>Estado</th>
							<th>Código</th>
							<th>Nombre</th>
							<th>Categoría</th>
							<th>Proveedor</th>
							<th>Venta</th>
							<th>Costo</th>
							<th>Motivo</th>
						</tr>
					</thead>
					<tbody data-preview-body></tbody>
				</table>
			</div>
			<div class="sg-import-actions">
				<button type="button" class="sg-focus-ring sg-import-primary" data-apply>
					Confirmar e importar
				</button>
				<a class="sg-focus-ring" href="/lists/inventory/products">Cancelar</a>
			</div>
		</section>

		<section class="sg-import-card sg-glass" data-step="done" hidden>
			<strong>Listo</strong>
			<p data-done-message></p>
			<a class="sg-focus-ring sg-import-primary" href="/lists/inventory/products">Volver a productos</a>
		</section>
	</main>
</ShellLayout>

<script define:vars={{ statusLabels, reasonLabels, mappingFieldLabels, mappingUiFields, requiredMappingFields, priceMappingFields }}>
	const root = document.querySelector('[data-price-import]');
	if (!(root instanceof HTMLElement)) {
		// no-op
	} else {
		const statusEl = root.querySelector('[data-status]');
		const fileInput = root.querySelector('[data-file-input]');
		const mappingSection = root.querySelector('[data-step="mapping"]');
		const mappingFieldsEl = root.querySelector('[data-mapping-fields]');
		const mapMetaEl = root.querySelector('[data-map-meta]');
		const confirmMappingBtn = root.querySelector('[data-confirm-mapping]');
		const backUploadBtn = root.querySelector('[data-back-upload]');
		const previewSection = root.querySelector('[data-step="preview"]');
		const doneSection = root.querySelector('[data-step="done"]');
		const uploadSection = root.querySelector('[data-step="upload"]');
		const bodyEl = root.querySelector('[data-preview-body]');
		const countsEl = root.querySelector('[data-counts]');
		const errorBanner = root.querySelector('[data-import-error-banner]');
		const doneMessage = root.querySelector('[data-done-message]');
		const applyBtn = root.querySelector('[data-apply]');
		const downloadBtn = root.querySelector('[data-download-template]');

		/** @type {any[]} */
		let lines = [];
		/** @type {string[]} */
		let fileHeaders = [];
		/** @type {Record<string, string>} */
		let currentMapping = {};
		let pendingFilename = '';
		let pendingContent = '';

		function setStatus(text, state = 'pending') {
			if (!(statusEl instanceof HTMLElement)) return;
			statusEl.hidden = !text;
			statusEl.textContent = text || '';
			statusEl.dataset.state = state;
		}

		function labelStatus(status) {
			return statusLabels[status] || status || '';
		}

		function labelReason(reason) {
			return reasonLabels[reason] || reason || '';
		}

		function hideAllSteps() {
			for (const section of [uploadSection, mappingSection, previewSection, doneSection]) {
				if (section instanceof HTMLElement) section.hidden = true;
			}
		}

		function showStep(step) {
			hideAllSteps();
			if (step === 'upload' && uploadSection instanceof HTMLElement) uploadSection.hidden = false;
			if (step === 'mapping' && mappingSection instanceof HTMLElement) mappingSection.hidden = false;
			if (step === 'preview' && previewSection instanceof HTMLElement) previewSection.hidden = false;
			if (step === 'done' && doneSection instanceof HTMLElement) doneSection.hidden = false;
		}

		function readMappingFromForm() {
			/** @type {Record<string, string>} */
			const mapping = {};
			if (!(mappingFieldsEl instanceof HTMLElement)) return mapping;
			for (const select of mappingFieldsEl.querySelectorAll('select[data-map-field]')) {
				if (!(select instanceof HTMLSelectElement)) continue;
				const field = select.dataset.mapField || '';
				const value = select.value.trim();
				if (field && value) mapping[field] = value;
			}
			return mapping;
		}

		function validateMapping(mapping) {
			if (!mapping.name) {
				return 'Indicá qué columna es el nombre del producto.';
			}
			if (!mapping.list_price && !mapping.standard_price) {
				return 'Indicá al menos una columna de precio (venta o costo).';
			}
			return '';
		}

		function renderMappingForm(headers, suggestedMapping, rowCount, headerRowIndex) {
			if (!(mappingFieldsEl instanceof HTMLElement)) return;
			currentMapping = { ...suggestedMapping };
			fileHeaders = headers;
			mappingFieldsEl.innerHTML = '';

			for (const field of mappingUiFields) {
				const label = mappingFieldLabels[field] || field;
				const isRequired =
					requiredMappingFields.includes(field) ||
					(field === 'list_price' && !currentMapping.standard_price) ||
					(field === 'standard_price' && !currentMapping.list_price);
				const wrap = document.createElement('label');
				wrap.className = 'sg-import-map-field';
				const select = document.createElement('select');
				select.dataset.mapField = field;
				select.className = 'sg-focus-ring';
				const empty = document.createElement('option');
				empty.value = '';
				empty.textContent = '— No importar —';
				select.appendChild(empty);
				for (const header of headers) {
					const opt = document.createElement('option');
					opt.value = header;
					opt.textContent = header;
					if (currentMapping[field] === header) opt.selected = true;
					select.appendChild(opt);
				}
				const title = document.createElement('span');
				title.textContent = isRequired && field !== 'standard_price' && field !== 'list_price'
					? `${label} *`
					: field === 'list_price' || field === 'standard_price'
						? `${label} (al menos uno *)`
						: label;
				wrap.appendChild(title);
				wrap.appendChild(select);
				mappingFieldsEl.appendChild(wrap);
			}

			if (mapMetaEl instanceof HTMLElement) {
				const rowHint =
					headerRowIndex > 0
						? ` Encabezados detectados en la fila ${headerRowIndex + 1}.`
						: '';
				mapMetaEl.hidden = false;
				mapMetaEl.textContent = `${rowCount} filas de datos · ${headers.length} columnas.${rowHint}`;
			}
			showStep('mapping');
		}

		async function requestPreview(filename, content, mapping) {
			const validationError = validateMapping(mapping);
			if (validationError) {
				setStatus(validationError, 'error');
				return false;
			}
			setStatus('Generando preview…');
			const response = await fetch('/api/inventory/price-list-import', {
				method: 'POST',
				credentials: 'same-origin',
				headers: { 'content-type': 'application/json' },
				body: JSON.stringify({
					action: 'preview',
					filename,
					content,
					mapping,
				}),
			});
			const payload = await response.json().catch(() => ({}));
			if (!response.ok) {
				throw new Error(payload?.error?.message || 'No se pudo analizar');
			}
			renderPreview(payload.preview);
			setStatus('Preview listo. Revisá y confirmá.', 'ok');
			return true;
		}

		function selectedCount() {
			let n = 0;
			root.querySelectorAll('input[data-line]').forEach((input) => {
				if (input instanceof HTMLInputElement && input.checked && !input.disabled) {
					n += 1;
				}
			});
			return n;
		}

		function syncApplyButton() {
			if (!(applyBtn instanceof HTMLButtonElement)) return;
			const n = selectedCount();
			applyBtn.textContent = `Confirmar e importar (${n})`;
			applyBtn.dataset.applyCount = String(n);
			applyBtn.disabled = n === 0;
		}

		function isExcelFile(file) {
			const name = String(file?.name || '').toLowerCase();
			return name.endsWith('.xlsx') || name.endsWith('.xls');
		}

		async function readFileAsText(file) {
			return await file.text();
		}

		async function readFileAsDataUrl(file) {
			return await new Promise((resolve, reject) => {
				const reader = new FileReader();
				reader.onload = () => resolve(String(reader.result || ''));
				reader.onerror = () => reject(new Error('No se pudo leer el archivo'));
				reader.readAsDataURL(file);
			});
		}

		function renderPreview(preview) {
			lines = preview.lines || [];
			const counts = preview.counts || {
				create: 0,
				update: 0,
				review: 0,
				error: 0,
			};
			if (countsEl instanceof HTMLElement) {
				countsEl.innerHTML = [
					`<span class="sg-import-chip is-create">Crear ${counts.create}</span>`,
					`<span class="sg-import-chip is-update">Actualizar ${counts.update}</span>`,
					`<span class="sg-import-chip is-review">Revisar ${counts.review}</span>`,
					`<span class="sg-import-chip is-error">Error ${counts.error}</span>`,
				].join('');
			}
			if (errorBanner instanceof HTMLElement) {
				if (counts.error > 0) {
					errorBanner.hidden = false;
					errorBanner.textContent = `${counts.error} filas con error no se van a importar. Corregí el archivo o confirmá solo las filas OK.`;
				} else {
					errorBanner.hidden = true;
					errorBanner.textContent = '';
				}
			}
			if (!(bodyEl instanceof HTMLElement)) return;
			bodyEl.innerHTML = '';
			for (const line of lines) {
				const tr = document.createElement('tr');
				tr.dataset.status = line.status;
				tr.innerHTML = `
					<td><input type="checkbox" data-line="${line.lineNumber}" ${line.selected ? 'checked' : ''} ${line.status === 'error' ? 'disabled' : ''} /></td>
					<td>${line.lineNumber}</td>
					<td>${escapeHtml(labelStatus(line.status))}</td>
					<td>${escapeHtml(line.default_code || line.barcode || '')}</td>
					<td>${escapeHtml(line.name || '')}</td>
					<td>${escapeHtml(line.categoria || '')}</td>
					<td>${escapeHtml(line.proveedor || '')}</td>
					<td>${line.list_price ?? ''}</td>
					<td>${line.standard_price ?? ''}</td>
					<td>${escapeHtml(labelReason(line.reason || ''))}</td>
				`;
				bodyEl.appendChild(tr);
			}
			bodyEl.querySelectorAll('input[data-line]').forEach((input) => {
				input.addEventListener('change', syncApplyButton);
			});
			showStep('preview');
			syncApplyButton();
		}

		function escapeHtml(value) {
			return String(value)
				.replaceAll('&', '&amp;')
				.replaceAll('<', '&lt;')
				.replaceAll('>', '&gt;')
				.replaceAll('"', '&quot;');
		}

		downloadBtn?.addEventListener('click', async () => {
			setStatus('Preparando plantilla…');
			try {
				const response = await fetch('/api/inventory/price-list-import', {
					method: 'POST',
					credentials: 'same-origin',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ action: 'template' }),
				});
				const payload = await response.json().catch(() => ({}));
				if (!response.ok) throw new Error(payload?.error?.message || 'No se pudo descargar');
				const blob = new Blob([payload.content || ''], { type: 'text/csv;charset=utf-8' });
				const url = URL.createObjectURL(blob);
				const a = document.createElement('a');
				a.href = url;
				a.download = payload.filename || 'plantilla.csv';
				a.click();
				URL.revokeObjectURL(url);
				setStatus('Plantilla lista', 'ok');
			} catch (error) {
				setStatus(error instanceof Error ? error.message : 'Error', 'error');
			}
		});

		fileInput?.addEventListener('change', async () => {
			if (!(fileInput instanceof HTMLInputElement) || !fileInput.files?.length) return;
			const file = fileInput.files[0];
			setStatus('Analizando archivo…');
			try {
				const content = isExcelFile(file)
					? await readFileAsDataUrl(file)
					: await readFileAsText(file);
				pendingFilename = file.name;
				pendingContent = content;

				const response = await fetch('/api/inventory/price-list-import', {
					method: 'POST',
					credentials: 'same-origin',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({
						action: 'analyze',
						filename: file.name,
						content,
					}),
				});
				const payload = await response.json().catch(() => ({}));
				if (!response.ok) throw new Error(payload?.error?.message || 'No se pudo analizar');

				const analysis = payload.analysis || {};
				if (analysis.needsMapping) {
					renderMappingForm(
						analysis.headers || [],
						analysis.suggestedMapping || {},
						analysis.rowCount || 0,
						analysis.headerRowIndex || 0
					);
					setStatus('Revisá el mapeo de columnas y continuá.', 'pending');
					return;
				}

				await requestPreview(file.name, content, analysis.suggestedMapping || {});
			} catch (error) {
				setStatus(error instanceof Error ? error.message : 'Error', 'error');
			}
		});

		confirmMappingBtn?.addEventListener('click', async () => {
			if (!(confirmMappingBtn instanceof HTMLButtonElement)) return;
			confirmMappingBtn.disabled = true;
			try {
				const mapping = readMappingFromForm();
				await requestPreview(pendingFilename, pendingContent, mapping);
			} catch (error) {
				setStatus(error instanceof Error ? error.message : 'Error', 'error');
			} finally {
				confirmMappingBtn.disabled = false;
			}
		});

		backUploadBtn?.addEventListener('click', () => {
			showStep('upload');
			setStatus('');
			if (fileInput instanceof HTMLInputElement) fileInput.value = '';
		});

		applyBtn?.addEventListener('click', async () => {
			if (!(applyBtn instanceof HTMLButtonElement) || applyBtn.disabled) return;
			applyBtn.disabled = true;
			setStatus('Importando…');
			try {
				const selectedMap = new Map();
				root.querySelectorAll('input[data-line]').forEach((input) => {
					if (input instanceof HTMLInputElement) {
						selectedMap.set(Number(input.dataset.line), input.checked);
					}
				});
				const payloadLines = lines.map((line) => ({
					...line,
					selected: Boolean(selectedMap.get(line.lineNumber)),
				}));
				const response = await fetch('/api/inventory/price-list-import', {
					method: 'POST',
					credentials: 'same-origin',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ action: 'apply', lines: payloadLines }),
				});
				const payload = await response.json().catch(() => ({}));
				if (!response.ok) throw new Error(payload?.error?.message || 'No se pudo importar');
				showStep('done');
				if (doneMessage instanceof HTMLElement) {
					doneMessage.textContent = `Creados: ${payload.created} · Actualizados: ${payload.updated} · Omitidos: ${payload.skipped}`;
				}
				setStatus('Importación finalizada', 'ok');
			} catch (error) {
				setStatus(error instanceof Error ? error.message : 'Error', 'error');
				syncApplyButton();
			}
		});
	}
</script>

<style>
	.sg-import-page {
		max-width: 78rem;
		margin: 0 auto;
		display: grid;
		gap: 1.25rem;
	}
	.sg-import-page header p {
		margin: 0 0 0.35rem;
		color: var(--sg-text-muted-dark);
		font-size: 0.78rem;
		font-weight: 500;
	}
	.sg-import-page header h1 {
		margin: 0;
		font-size: clamp(1.8rem, 3.5vw, 2.6rem);
		font-weight: 600;
		letter-spacing: -0.04em;
	}
	.sg-import-lead {
		max-width: 40rem;
		margin: 0.75rem 0 0 !important;
		font-size: 0.92rem !important;
		line-height: 1.45;
	}
	.sg-import-card {
		border-radius: var(--sg-radius-card);
		padding: 1.25rem 1.35rem;
		display: grid;
		gap: 0.9rem;
	}
	.sg-import-card strong {
		font-size: 1.05rem;
	}
	.sg-import-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		align-items: center;
	}
	.sg-import-actions button,
	.sg-import-actions a,
	.sg-import-file {
		border: 1px solid var(--sg-glass-border);
		border-radius: var(--sg-radius-pill);
		padding: 0.55rem 0.9rem;
		color: var(--sg-text-on-dark);
		background: var(--sg-glass-fill);
		font-size: 0.8rem;
		font-weight: 600;
		text-decoration: none;
		cursor: pointer;
	}
	.sg-import-actions button:disabled {
		opacity: 0.45;
		cursor: not-allowed;
	}
	.sg-import-primary {
		border-color: rgba(155, 231, 176, 0.45) !important;
	}
	.sg-import-file {
		display: inline-flex;
		align-items: center;
	}
	.sg-import-file input {
		display: none;
	}
	.sg-import-map-lead {
		max-width: 42rem;
		margin: 0 !important;
		font-size: 0.88rem !important;
	}
	.sg-import-map-meta {
		margin: 0;
		font-size: 0.8rem;
		color: var(--sg-text-muted-dark);
	}
	.sg-import-map-grid {
		display: grid;
		gap: 0.75rem;
		grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
	}
	.sg-import-map-field {
		display: grid;
		gap: 0.35rem;
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--sg-text-muted-dark);
	}
	.sg-import-map-field select {
		border: 1px solid var(--sg-glass-border);
		border-radius: 0.65rem;
		padding: 0.5rem 0.65rem;
		background: rgba(0, 0, 0, 0.25);
		color: var(--sg-text-on-dark);
		font-size: 0.82rem;
	}
	.sg-import-status[data-state='error'] {
		color: #ffb4a8;
	}
	.sg-import-status[data-state='ok'] {
		color: #9be7b0;
	}
	.sg-import-counts {
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}
	.sg-import-chip {
		display: inline-flex;
		align-items: center;
		border-radius: var(--sg-radius-pill);
		padding: 0.3rem 0.65rem;
		font-size: 0.78rem;
		font-weight: 650;
		border: 1px solid var(--sg-glass-border);
		background: rgba(0, 0, 0, 0.22);
		color: var(--sg-text-muted-dark);
	}
	.sg-import-chip.is-create {
		color: #9be7b0;
		border-color: rgba(155, 231, 176, 0.35);
	}
	.sg-import-chip.is-update {
		color: #b7d7ff;
		border-color: rgba(155, 200, 255, 0.35);
	}
	.sg-import-chip.is-review {
		color: #ffd28a;
		border-color: rgba(255, 210, 138, 0.35);
	}
	.sg-import-chip.is-error {
		color: #ffb4a8;
		border-color: rgba(255, 180, 168, 0.4);
	}
	.sg-import-error-banner {
		margin: 0;
		border-radius: 0.75rem;
		padding: 0.7rem 0.85rem;
		border: 1px solid rgba(255, 180, 168, 0.4);
		background: rgba(80, 25, 15, 0.35);
		color: #ffd0c6;
		font-size: 0.84rem;
		line-height: 1.4;
	}
	.sg-import-table-wrap {
		overflow: auto;
		max-height: min(55vh, 36rem);
		border: 1px solid var(--sg-glass-border);
		border-radius: 0.85rem;
	}
	.sg-import-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.8rem;
	}
