---
interface Props {
	categoryId: number;
	categoryName: string;
	apiPath: string;
	productCount?: number;
}

const { categoryId, categoryName, apiPath, productCount = 0 } = Astro.props;
const productsHref = `/lists/inventory/products?categ_id=${categoryId}`;
const countLabel =
	productCount === 1
		? '1 producto activo'
		: `${productCount.toLocaleString('es-AR')} productos activos`;
---

<section
	class="sg-category-products sg-glass"
	data-category-purge
	data-category-id={categoryId}
	data-category-name={categoryName}
	data-api={apiPath}
>
	<header class="sg-category-products-head">
		<div>
			<strong>Productos</strong>
			<p class="sg-category-products-count" data-purge-count>{countLabel}</p>
		</div>
		<a class="sg-focus-ring sg-category-products-view" href={productsHref} data-view-products>
			{productCount === 1
				? 'Ver productos (1)'
				: `Ver productos (${productCount.toLocaleString('es-AR')})`}
		</a>
	</header>

	<p class="sg-category-products-lead">
		Podés abrir el listado, eliminar solo los productos (híbrido: borrar o archivar) o eliminar
		la categoría completa (borrado definitivo de productos + categoría). No incluye subcategorías.
	</p>

	<label class="sg-category-products-confirm">
		<span>Escribí el nombre de la categoría para confirmar eliminaciones</span>
		<input
			class="sg-focus-ring"
			type="text"
			autocomplete="off"
			data-purge-confirm
			placeholder={categoryName}
		/>
	</label>

	<div class="sg-category-products-actions">
		<a class="sg-focus-ring sg-category-products-view-btn" href={productsHref}>
			Ver productos
		</a>
		<button class="sg-focus-ring" type="button" data-purge-btn disabled>
			Eliminar productos
		</button>
		<button
			class="sg-focus-ring sg-category-delete-btn"
			type="button"
			data-delete-category-btn
			disabled
		>
			Eliminar categoría completa
		</button>
		<span class="sg-category-products-status" data-purge-status hidden></span>
	</div>
</section>

<script>
	const root = document.querySelector('[data-category-purge]');
	if (root instanceof HTMLElement) {
		const api = root.dataset.api || '';
		const categoryId = Number(root.dataset.categoryId);
		const expectedName = root.dataset.categoryName || '';
		const countEl = root.querySelector('[data-purge-count]');
		const viewLink = root.querySelector('[data-view-products]');
		const confirmInput = root.querySelector('[data-purge-confirm]');
		const btn = root.querySelector('[data-purge-btn]');
		const deleteCatBtn = root.querySelector('[data-delete-category-btn]');
		const status = root.querySelector('[data-purge-status]');

		function setStatus(text, state) {
			if (!(status instanceof HTMLElement)) return;
			status.hidden = !text;
			status.textContent = text || '';
			status.dataset.state = state || '';
		}

		function syncButtons() {
			const ok =
				confirmInput instanceof HTMLInputElement &&
				confirmInput.value.trim().toLowerCase() === expectedName.trim().toLowerCase() &&
				expectedName.trim().length > 0;
			if (btn instanceof HTMLButtonElement) btn.disabled = !ok;
			if (deleteCatBtn instanceof HTMLButtonElement) deleteCatBtn.disabled = !ok;
		}

		function formatCount(n) {
			if (n === 1) return '1 producto activo';
			return `${n.toLocaleString('es-AR')} productos activos`;
		}

		function formatViewLabel(n) {
			return n === 1 ? 'Ver productos (1)' : `Ver productos (${n.toLocaleString('es-AR')})`;
		}

		async function loadPreview() {
			try {
				const response = await fetch(api, {
					method: 'POST',
					credentials: 'same-origin',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ action: 'preview', categoryId }),
				});
				const payload = await response.json().catch(() => ({}));
				if (!response.ok) {
					throw new Error(payload?.error?.message || 'No se pudo cargar el preview');
				}
				const n = Number(payload.productCount) || 0;
				if (countEl instanceof HTMLElement) countEl.textContent = formatCount(n);
				if (viewLink instanceof HTMLAnchorElement) viewLink.textContent = formatViewLabel(n);
			} catch (error) {
				if (countEl instanceof HTMLElement) {
					countEl.textContent =
						error instanceof Error ? error.message : 'No se pudo cargar el preview';
				}
			}
		}

		confirmInput?.addEventListener('input', syncButtons);

		btn?.addEventListener('click', async () => {
			if (!(btn instanceof HTMLButtonElement) || btn.disabled) return;
			if (
				!window.confirm(
					`¿Eliminar/archivar los productos de «${expectedName}»? Esta acción no se puede deshacer fácilmente.`
				)
			) {
				return;
			}
			btn.disabled = true;
			if (deleteCatBtn instanceof HTMLButtonElement) deleteCatBtn.disabled = true;
			setStatus('Procesando…', 'pending');
			try {
				const confirmName =
					confirmInput instanceof HTMLInputElement ? confirmInput.value : '';
				const response = await fetch(api, {
					method: 'POST',
					credentials: 'same-origin',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({
						action: 'purge',
						categoryId,
						confirmName,
					}),
				});
				const payload = await response.json().catch(() => ({}));
				if (!response.ok) {
					throw new Error(payload?.error?.message || 'No se pudo eliminar');
				}
				setStatus(payload.summary || 'Listo', 'ok');
				await loadPreview();
				syncButtons();
			} catch (error) {
				setStatus(error instanceof Error ? error.message : 'Error', 'error');
				syncButtons();
			}
		});

		deleteCatBtn?.addEventListener('click', async () => {
			if (!(deleteCatBtn instanceof HTMLButtonElement) || deleteCatBtn.disabled) return;
			if (
				!window.confirm(
					`¿Eliminar permanentemente la categoría «${expectedName}» y todos sus productos? No se puede deshacer.`
				)
			) {
				return;
			}
			deleteCatBtn.disabled = true;
			if (btn instanceof HTMLButtonElement) btn.disabled = true;
			setStatus('Eliminando categoría…', 'pending');
			try {
				const confirmName =
					confirmInput instanceof HTMLInputElement ? confirmInput.value : '';
				const response = await fetch(api, {
					method: 'POST',
					credentials: 'same-origin',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({
						action: 'delete-category',
						categoryId,
						confirmName,
					}),
				});
				const payload = await response.json().catch(() => ({}));
				if (!response.ok) {
					throw new Error(payload?.error?.message || 'No se pudo eliminar la categoría');
				}
				if (payload.categoryDeleted) {
					setStatus(payload.summary || 'Categoría eliminada', 'ok');
					window.setTimeout(() => {
						window.location.href = '/lists/inventory/categories';
					}, 500);
					return;
				}
				setStatus(
					payload.summary ||
						'No se pudo borrar algún producto; la categoría se conservó.',
					'error'
				);
				await loadPreview();
				syncButtons();
			} catch (error) {
				setStatus(error instanceof Error ? error.message : 'Error', 'error');
				syncButtons();
			}
		});

		loadPreview();
		syncButtons();
	}
</script>

<style>
	.sg-category-products {
		max-width: 48rem;
		margin: 1.25rem auto 0;
		padding: 1.25rem 1.35rem;
		display: grid;
		gap: 0.9rem;
	}
	.sg-category-products-head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.75rem 1rem;
	}
	.sg-category-products-head strong {
		display: block;
		font-size: 1.1rem;
	}
	.sg-category-products-count,
	.sg-category-products-lead {
		margin: 0.35rem 0 0;
		color: var(--sg-text-muted-dark);
		font-size: 0.92rem;
		line-height: 1.45;
	}
	.sg-category-products-lead {
		margin: 0;
	}
	.sg-category-products-view {
		font-size: 0.88rem;
		font-weight: 650;
		color: var(--sg-text-on-dark);
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}
	.sg-category-products-confirm {
		display: grid;
		gap: 0.4rem;
		font-size: 0.88rem;
	}
	.sg-category-products-confirm input {
		padding: 0.55rem 0.7rem;
		border-radius: 0.55rem;
		border: 1px solid color-mix(in srgb, var(--sg-ink) 14%, transparent);
		background: color-mix(in srgb, white 70%, transparent);
	}
	.sg-category-products-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
	}
	.sg-category-products-view-btn {
		display: inline-flex;
		align-items: center;
		padding: 0.55rem 0.9rem;
		border-radius: 0.6rem;
		border: 1px solid var(--sg-glass-border);
		background: var(--sg-glass-fill);
		color: var(--sg-text-on-dark);
		font-weight: 600;
		text-decoration: none;
	}
	.sg-category-products-actions button {
		padding: 0.55rem 0.9rem;
		border-radius: 0.6rem;
		border: 1px solid color-mix(in srgb, #b42318 35%, transparent);
		background: color-mix(in srgb, #b42318 12%, white);
		color: #7a1b14;
		font-weight: 600;
		cursor: pointer;
	}
	.sg-category-products-actions button:disabled {
		opacity: 0.45;
		cursor: not-allowed;
	}
	.sg-category-delete-btn {
		border-color: color-mix(in srgb, #7a1b14 55%, transparent) !important;
		background: color-mix(in srgb, #b42318 22%, white) !important;
	}
	.sg-category-products-status[data-state='ok'] {
		color: #0f6b3a;
	}
	.sg-category-products-status[data-state='error'] {
		color: #b42318;
	}
	.sg-category-products-status[data-state='pending'] {
		color: var(--sg-text-muted-dark);
	}
</style>
