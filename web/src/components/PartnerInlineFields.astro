---
/**
 * Inline partner fields (name required when used without partnerId).
 */
interface Props {
  /** e.g. "Cliente" | "Proveedor" */
  label?: string;
  namePrefix?: string;
}

const { label = "Contacto", namePrefix = "partnerNew" } = Astro.props;
---

<div class="sg-partner-inline" data-partner-inline>
	<p class="sg-partner-inline-hint">O cargá uno nuevo</p>
	<div class="sg-partner-inline-grid">
		<label>
			<span>{label} (nombre) *</span>
			<input
				class="sg-focus-ring"
				type="text"
				name={`${namePrefix}Name`}
				autocomplete="name"
				data-partner-new-name
			/>
		</label>
		<label>
			<span>Celular</span>
			<input
				class="sg-focus-ring"
				type="tel"
				name={`${namePrefix}Phone`}
				autocomplete="tel"
				data-partner-new-phone
			/>
		</label>
		<label>
			<span>Email</span>
			<input
				class="sg-focus-ring"
				type="email"
				name={`${namePrefix}Email`}
				autocomplete="email"
				data-partner-new-email
			/>
		</label>
		<label>
			<span>CUIT (opcional)</span>
			<input
				class="sg-focus-ring"
				type="text"
				name={`${namePrefix}Vat`}
				inputmode="numeric"
				autocomplete="off"
				data-partner-new-vat
			/>
		</label>
	</div>
</div>

<style>
	.sg-partner-inline {
		margin-top: 0.75rem;
		padding-top: 0.75rem;
		border-top: 1px solid color-mix(in srgb, var(--sg-text) 12%, transparent);
	}
	.sg-partner-inline-hint {
		margin: 0 0 0.5rem;
		font-size: 0.875rem;
		opacity: 0.85;
	}
	.sg-partner-inline-grid {
		display: grid;
		gap: 0.65rem;
		grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
	}
	.sg-partner-inline-grid label {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		font-size: 0.875rem;
	}
</style>
