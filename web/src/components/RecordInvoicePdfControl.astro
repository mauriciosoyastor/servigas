---
import InvoicePdfModalHost from './InvoicePdfModalHost.astro';
import { invoicePdfPath } from '../lib/shell/invoice-pdf.ts';

interface Props {
	listKey: string;
	recordId: number;
	title?: string;
}

const { listKey, recordId, title = '' } = Astro.props;
const pdfPath = invoicePdfPath(listKey, recordId);
---

{/* Single root element required for Astro named-slot projection. */}
<section
	class="sg-invoice-pdf"
	data-invoice-pdf={pdfPath ? true : undefined}
	data-list-key={listKey}
	hidden={!pdfPath}
>
	{
		pdfPath ? (
			<>
				<button
					class="sg-focus-ring"
					type="button"
					data-invoice-pdf-open
					data-pdf-url={pdfPath}
					data-pdf-title={title || 'Comprobante'}
				>
					Ver PDF
				</button>
				<a
					class="sg-invoice-pdf-download sg-focus-ring"
					href={`${pdfPath}?download=1`}
					download
					data-invoice-pdf-download
				>
					Descargar
				</a>
				<InvoicePdfModalHost />
			</>
		) : null
	}
</section>

<style>
	.sg-invoice-pdf {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
		margin-top: 1rem;
	}

	.sg-invoice-pdf button[data-invoice-pdf-open],
	.sg-invoice-pdf-download {
		border: 1px solid rgba(155, 200, 255, 0.45);
		border-radius: var(--sg-radius-pill);
		padding: 0.55rem 0.95rem;
		color: #b7d7ff;
		background: rgba(25, 45, 75, 0.45);
		font-size: 0.82rem;
		font-weight: 650;
		cursor: pointer;
		text-decoration: none;
	}

	.sg-invoice-pdf-download {
		border-color: rgba(255, 255, 255, 0.18);
		color: var(--sg-text-muted-dark, #c5d0dc);
		background: rgba(255, 255, 255, 0.04);
	}
</style>
