---
import { RAIL_ITEMS } from '../lib/shell/rail-nav.ts';

interface Props {
	active?: string;
}

const { active = 'home' } = Astro.props;
const items = RAIL_ITEMS;
---

<aside class="sg-rail sg-glass" aria-label="Navegación principal">
	<a
		class="sg-brand sg-focus-ring"
		href="/"
		aria-label="Servigas, inicio"
		data-tour="rail-home"
	>
		<img
			class="sg-brand-mark"
			src="/servigas-mark.png?v=2"
			alt=""
			width="56"
			height="56"
			decoding="async"
		/>
		<span class="sg-brand-name">Servigas</span>
	</a>

	<nav class="sg-rail-nav">
		{items.map((item) => (
			<a
				href={item.href}
				class:list={['sg-rail-link', 'sg-focus-ring', { 'is-active': active === item.app }]}
				aria-current={active === item.app ? 'page' : undefined}
				title={item.label}
				data-tour={`rail-${item.app}`}
			>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d={item.icon}></path>
				</svg>
				<span>{item.label}</span>
			</a>
		))}
	</nav>
</aside>

<style>
	.sg-rail {
		position: fixed;
		z-index: 20;
		inset: 1rem auto 1rem 1rem;
		display: flex;
		width: 5.25rem;
		flex-direction: column;
		align-items: center;
		border-radius: 1.75rem;
		padding: 1rem 0.65rem;
	}
	.sg-brand {
		display: grid;
		justify-items: center;
		gap: 0.35rem;
		color: white;
		text-decoration: none;
	}
	.sg-brand-mark {
		display: block;
		width: 2.75rem;
		height: auto;
		object-fit: contain;
	}
	.sg-brand-name {
		font-size: 0.62rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		line-height: 1.1;
		text-align: center;
	}
	.sg-rail-nav {
		display: grid;
		width: 100%;
		gap: 0.35rem;
		margin-top: auto;
		margin-bottom: auto;
	}
	.sg-rail-link {
		display: grid;
		justify-items: center;
		gap: 0.2rem;
		border-radius: 1rem;
		padding: 0.55rem 0.15rem;
		color: var(--sg-text-muted-dark);
		text-decoration: none;
		transition: background-color 180ms ease, color 180ms ease, transform 180ms ease;
	}
	.sg-rail-link:hover {
		color: white;
		background: rgba(255, 255, 255, 0.08);
		transform: translateY(-1px);
	}
	.sg-rail-link.is-active {
		color: white;
		background: var(--sg-glass-fill-strong);
		box-shadow: inset 3px 0 var(--sg-flame-orange);
	}
	.sg-rail-link svg {
		width: 1.15rem;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.8;
	}
	.sg-rail-link span {
		font-size: 0.52rem;
		font-weight: 500;
		text-align: center;
		line-height: 1.15;
	}
	@media (max-width: 720px) {
		.sg-rail {
			inset: auto 0.5rem 0.75rem;
			width: auto;
			flex-direction: row;
			border-radius: 1.25rem;
			padding: 0.4rem;
		}
		.sg-brand {
			display: none;
		}
		.sg-rail-nav {
			grid-template-columns: repeat(6, 1fr);
			margin: 0;
			gap: 0.2rem;
		}
		.sg-rail-link {
			padding: 0.45rem 0.05rem;
		}
		.sg-rail-link.is-active {
			box-shadow: inset 0 -3px var(--sg-flame-orange);
		}
		.sg-rail-link span {
			font-size: 0.48rem;
		}
	}
</style>
