---
interface FieldOption {
	value: string;
	label: string;
}

interface FieldDef {
	key: string;
	label: string;
	required?: boolean;
	type?: 'text' | 'email' | 'select';
	options?: FieldOption[];
}

interface Props {
	listKey: string;
	apiPath: string;
	title: string;
	hint: string;
	fields: FieldDef[];
	listPath: string;
}

const { listKey, apiPath, title, hint, fields, listPath } = Astro.props;
const enableCuitWarn =
	fields.some((field) => field.key === 'sg_invoice_dest') &&
	fields.some((field) => field.key === 'vat');
---

<section class="sg-record-create sg-glass" data-record-create data-list-key={listKey}>
	<strong>{title}</strong>
	<p>{hint}</p>
	<form class="sg-record-create-form" data-record-create-form>
		{fields.map((field) => (
			<label>
				<span>
					{field.label}
					{field.required ? ' *' : ''}
				</span>
				{field.type === 'select' && field.options?.length ? (
					<select
						class="sg-focus-ring"
						name={field.key}
						required={field.required}
					>
						{field.options.map((option) => (
							<option value={option.value}>{option.label}</option>
						))}
					</select>
				) : (
					<input
						class="sg-focus-ring"
						type={field.type === 'email' || field.key === 'email' ? 'email' : 'text'}
						name={field.key}
						required={field.required}
						autocomplete="off"
					/>
				)}
			</label>
		))}
		{enableCuitWarn ? (
			<p class="sg-cuit-fiscal-warn" data-cuit-fiscal-warn hidden></p>
		) : null}
		<div class="sg-record-create-actions">
			<button class="sg-focus-ring" type="submit">Crear</button>
			<a class="sg-focus-ring" href={listPath}>Cancelar</a>
			<span class="sg-record-create-status" data-record-create-status hidden></span>
		</div>
	</form>
</section>

<script define:vars={{ apiPath, enableCuitWarn }}>
	const root = document.querySelector('[data-record-create]');
	const form = root?.querySelector('[data-record-create-form]');
	const status = root?.querySelector('[data-record-create-status]');
	const cuitWarn = root?.querySelector('[data-cuit-fiscal-warn]');
	const CUIT_WEIGHTS = [5, 4, 3, 2, 7, 6, 5, 4, 3, 2];
	const CUIT_MISSING_MSG = 'Este cliente es Con CUIT: cargá el CUIT para guardar.';
	const CUIT_INVALID_MSG = 'El CUIT no es válido (revisá los 11 dígitos).';

	const isValidCuitClient = (raw) => {
		const digits = String(raw || '').replace(/\D/g, '');
		if (digits.length !== 11) return false;
		let sum = 0;
		for (let i = 0; i < 10; i++) sum += Number(digits[i]) * CUIT_WEIGHTS[i];
		const rem = sum % 11;
		const expected = rem === 0 ? 0 : rem === 1 ? 9 : 11 - rem;
		return Number(digits[10]) === expected;
	};

	const refreshCuitWarn = () => {
		if (!enableCuitWarn || !(form instanceof HTMLFormElement) || !(cuitWarn instanceof HTMLElement)) {
			return;
		}
		const dest = String(new FormData(form).get('sg_invoice_dest') || 'cf').toLowerCase();
		const vat = String(new FormData(form).get('vat') || '').trim();
		let msg = '';
		if (dest === 'cuit' && !vat) msg = CUIT_MISSING_MSG;
		else if (vat && !isValidCuitClient(vat)) msg = CUIT_INVALID_MSG;
		if (msg) {
			cuitWarn.hidden = false;
			cuitWarn.textContent = msg;
		} else {
			cuitWarn.hidden = true;
			cuitWarn.textContent = '';
		}
	};

	if (form instanceof HTMLFormElement && enableCuitWarn) {
		form.addEventListener('input', refreshCuitWarn);
		form.addEventListener('change', refreshCuitWarn);
		refreshCuitWarn();
	}

	if (form instanceof HTMLFormElement && status instanceof HTMLElement) {
		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			status.hidden = false;
			status.textContent = 'Creando…';
			status.dataset.state = 'pending';

			const data = new FormData(form);
			const values = {};
			for (const [key, value] of data.entries()) {
				values[key] = String(value);
			}

			try {
				const response = await fetch(apiPath, {
					method: 'POST',
					credentials: 'same-origin',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ action: 'create', values }),
				});
				const payload = await response.json().catch(() => ({}));
				if (!response.ok) {
					throw new Error(payload?.error?.message || 'No se pudo crear');
				}
				status.textContent = 'Creado';
				status.dataset.state = 'ok';
				window.setTimeout(() => {
					window.location.href = payload.detailPath || '/';
				}, 350);
			} catch (error) {
				status.textContent =
					error instanceof Error ? error.message : 'No se pudo crear';
				status.dataset.state = 'error';
			}
		});
	}
</script>

<style>
	.sg-record-create {
		display: grid;
		gap: 0.65rem;
		width: 100%;
		max-width: none;
		border-radius: var(--sg-radius-card);
		padding: 1.2rem;
		box-sizing: border-box;
	}
	.sg-record-create p {
		margin: 0;
		color: var(--sg-text-muted-dark);
		font-size: 0.82rem;
		line-height: 1.45;
		max-width: 48rem;
	}
	.sg-record-create-form {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
		gap: 0.85rem 1.25rem;
		margin-top: 0.35rem;
	}
	.sg-record-create-form label {
		display: grid;
		gap: 0.35rem;
		min-width: 0;
	}
	.sg-record-create-form span {
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--sg-text-muted-dark);
	}
	.sg-record-create-form input,
	.sg-record-create-form select {
		border: 1px solid var(--sg-glass-border);
		border-radius: 0.75rem;
		padding: 0.65rem 0.8rem;
		color: var(--sg-text-on-dark);
		background: rgba(0, 0, 0, 0.22);
		font: inherit;
		width: 100%;
		box-sizing: border-box;
	}
	.sg-record-create-actions {
		grid-column: 1 / -1;
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.sg-record-create-actions button,
	.sg-record-create-actions a {
		border: 1px solid var(--sg-glass-border);
		border-radius: var(--sg-radius-pill);
		padding: 0.6rem 1rem;
		color: var(--sg-text-on-dark);
		background: var(--sg-glass-fill);
		font-size: 0.85rem;
		font-weight: 650;
		text-decoration: none;
		cursor: pointer;
	}
	.sg-record-create-status {
		font-size: 0.8rem;
		color: var(--sg-text-muted-dark);
	}
	.sg-record-create-status[data-state='ok'] {
		color: #9be7b0;
	}
	.sg-record-create-status[data-state='error'] {
		color: #ffb4a2;
	}
	.sg-cuit-fiscal-warn {
		grid-column: 1 / -1;
		margin: 0;
		font-size: 0.8rem;
		line-height: 1.4;
		color: #ffc107;
	}
</style>
