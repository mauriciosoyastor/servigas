---
import type { RecordListColumn, RecordListRow } from '../lib/bff/types.ts';
import { invoiceDestBadge } from '../lib/shell/invoice-dest.ts';
import { invoicePdfPath } from '../lib/shell/invoice-pdf.ts';
import { labelOdooSelection } from '../lib/shell/odoo-selection-labels.ts';

interface Props {
	columns: RecordListColumn[];
	rows: RecordListRow[];
	caption?: string;
	imageUploadApiPath?: string;
	invoicePdfListKey?: string;
}

const {
	columns,
	rows,
	caption = 'Registros',
	imageUploadApiPath = '',
	invoicePdfListKey = '',
} = Astro.props;

const showInvoicePdf = Boolean(invoicePdfListKey);

function formatCell(key: string, value: string | number | boolean | null): string {
	if (value === null || value === undefined || value === '') return '—';
	if (typeof value === 'boolean') return value ? 'Sí' : 'No';
	if (key === 'sg_invoice_dest') return invoiceDestBadge(value);
	if ((key === 'qty_available' || key === 'id') && typeof value === 'number') {
		return value.toLocaleString('es-AR');
	}
	return String(labelOdooSelection(key, value));
}

function rowPdfTitle(row: RecordListRow, id: number): string {
	const name = row.name;
	if (typeof name === 'string' && name.trim()) return name.trim();
	return `Comprobante ${id}`;
}
---

<div class="sg-record-table-wrap">
	<table class="sg-record-table">
		<caption class="sr-only">{caption}</caption>
		<thead>
			<tr>
				{columns.map((column) => (
					<th scope="col" data-col={column.key} data-kind={column.kind || 'text'}>
						{column.label}
					</th>
				))}
				{showInvoicePdf ? (
					<th scope="col" data-col="pdf" data-kind="action">
						PDF
					</th>
				) : null}
			</tr>
		</thead>
		<tbody>
			{rows.map((row) => {
				const href = typeof row.detail_path === 'string' ? row.detail_path : '';
				const recordId = Number(row.id);
				const pdfPath =
					showInvoicePdf && Number.isFinite(recordId)
						? invoicePdfPath(invoicePdfListKey, recordId)
						: '';
				return (
					<tr data-row-id={row.id}>
						{columns.map((column) => (
							<td data-col={column.key} data-kind={column.kind || 'text'} data-label={column.label}>
								{column.kind === 'image' ? (
									<div class="sg-record-thumb-wrap">
										{row.image_url ? (
											href ? (
												<a class="sg-record-thumb-link" href={href}>
												<img
													class="sg-record-thumb"
													src={String(row.image_url)}
													alt=""
													loading="lazy"
													width="40"
													height="40"
													data-product-thumb={row.id}
												/>
												</a>
											) : (
												<img
													class="sg-record-thumb"
													src={String(row.image_url)}
													alt=""
													loading="lazy"
													width="40"
													height="40"
													data-product-thumb={row.id}
												/>
											)
										) : (
											<span
												class="sg-record-thumb sg-record-thumb--empty"
												data-product-thumb={row.id}
												aria-hidden="true"
											/>
										)}
										{imageUploadApiPath ? (
											<button
												type="button"
												class="sg-record-thumb-upload sg-focus-ring"
												data-product-image-trigger
												data-record-id={String(row.id)}
												data-api-path={imageUploadApiPath}
												data-image-target={`[data-product-thumb="${row.id}"]`}
												aria-label={row.image_url ? 'Cambiar foto' : 'Agregar foto'}
											>
												<svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
													<path
														fill="currentColor"
														d="M9 3h6l1.5 2H20a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h3.5L9 3zm3 5a5 5 0 1 0 .001 10.001A5 5 0 0 0 12 8zm0 2.2a2.8 2.8 0 1 1 0 5.6 2.8 2.8 0 0 1 0-5.6z"
													/>
												</svg>
											</button>
										) : null}
									</div>
								) : href && column.key !== 'active' ? (
									<a class="sg-record-link" href={href}>
										{formatCell(column.key, row[column.key] ?? null)}
									</a>
								) : (
									formatCell(column.key, row[column.key] ?? null)
								)}
							</td>
						))}
						{showInvoicePdf ? (
							<td data-col="pdf" data-kind="action" data-label="PDF">
								{pdfPath ? (
									<button
										type="button"
										class="sg-record-pdf-btn sg-focus-ring"
										data-invoice-pdf-open
										data-pdf-url={pdfPath}
										data-pdf-title={rowPdfTitle(row, recordId)}
										aria-label={`Ver PDF de ${rowPdfTitle(row, recordId)}`}
									>
										PDF
									</button>
								) : (
									'—'
								)}
							</td>
						) : null}
					</tr>
				);
			})}
		</tbody>
	</table>
</div>

<style>
	.sg-record-pdf-btn {
		border: 1px solid rgba(155, 200, 255, 0.45);
		border-radius: var(--sg-radius-pill);
		padding: 0.35rem 0.7rem;
		color: #b7d7ff;
		background: rgba(25, 45, 75, 0.45);
		font-size: 0.75rem;
		font-weight: 650;
		cursor: pointer;
		white-space: nowrap;
	}

	.sg-record-table th[data-col='pdf'],
	.sg-record-table td[data-col='pdf'] {
		width: 1%;
		text-align: right;
		white-space: nowrap;
	}
</style>
