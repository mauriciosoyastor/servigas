---
interface InitialPartner {
	id: number;
	label: string;
}

interface InitialLine {
	productId: number;
	label: string;
	qty: number;
	price?: number;
	discount?: number;
}

interface Props {
	apiPath: string;
	listPath: string;
	partnerListKey: string;
	productListKey?: string;
	title?: string;
	hint?: string;
	partnerLabel?: string;
	partnerPlaceholder?: string;
	productPlaceholder?: string;
	submitLabel?: string;
	/** FP: require PDF/JPG/PNG proof attachment */
	requireAttachment?: boolean;
	/** FP: optional WhatsApp / Mail / Other source */
	showBillSource?: boolean;
	/** Hide CF/CUIT fiscal hints (vendor bills) */
	suppressFiscalHints?: boolean;
	/** FP: after PDF upload, suggest matched catalog lines */
	suggestLinesFromPdf?: boolean;
	/** update_invoice_draft mode */
	recordId?: number;
	formAction?: 'create' | 'update_invoice_draft';
	initialPartner?: InitialPartner | null;
	initialLines?: InitialLine[];
	pendingLabel?: string;
	successLabel?: string;
	cancelPath?: string;
}

const {
	apiPath,
	listPath,
	partnerListKey,
	productListKey = 'inventory/variants',
	title = 'Nueva cotización',
	hint = 'Buscá cliente y agregá una o más líneas (cant., precio, % desc.). Queda en borrador.',
	partnerLabel = 'Cliente',
	partnerPlaceholder = 'Buscar cliente…',
	productPlaceholder = 'Buscar producto por nombre o código…',
	submitLabel = 'Crear borrador',
	requireAttachment = false,
	showBillSource = false,
	suppressFiscalHints = false,
	suggestLinesFromPdf = false,
	recordId = 0,
	formAction = 'create',
	initialPartner = null,
	initialLines = [],
	pendingLabel = 'Creando…',
	successLabel = 'Creada',
	cancelPath = listPath,
} = Astro.props;

const isUpdate = formAction === 'update_invoice_draft' && recordId > 0;
---

<section
	class="sg-order-create sg-glass"
	data-order-create
	data-require-attachment={requireAttachment ? '1' : '0'}
	data-suppress-fiscal={suppressFiscalHints ? '1' : '0'}
	data-suggest-pdf={suggestLinesFromPdf ? '1' : '0'}
>
	<strong>{title}</strong>
	<p>{hint}</p>
	<form class="sg-order-create-form" data-order-create-form>
		<div class="sg-order-create-meta">
			{showBillSource ? (
				<div class="sg-order-bill-source" data-bill-source-select>
					<span id="sg-bill-source-label">Origen (opcional)</span>
					<button
						class="sg-focus-ring sg-order-bill-source-trigger"
						type="button"
						aria-haspopup="listbox"
						aria-expanded="false"
						aria-labelledby="sg-bill-source-label"
						data-bill-source-trigger
					>
						<span data-bill-source-label>Sin indicar</span>
						<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
							<path
								d="M4.2 6.2 8 10l3.8-3.8"
								fill="none"
								stroke="currentColor"
								stroke-width="1.6"
								stroke-linecap="round"
								stroke-linejoin="round"
							></path>
						</svg>
					</button>
					<ul
						class="sg-order-bill-source-list"
						role="listbox"
						aria-labelledby="sg-bill-source-label"
						hidden
						data-bill-source-list
					>
						<li
							role="option"
							tabindex="-1"
							aria-selected="true"
							data-value=""
							data-label="Sin indicar"
						>
							Sin indicar
						</li>
						<li
							role="option"
							tabindex="-1"
							aria-selected="false"
							data-value="whatsapp"
							data-label="WhatsApp"
						>
							WhatsApp
						</li>
						<li role="option" tabindex="-1" aria-selected="false" data-value="mail" data-label="Mail">
							Mail
						</li>
						<li role="option" tabindex="-1" aria-selected="false" data-value="other" data-label="Otro">
							Otro
						</li>
					</ul>
					<select class="sg-order-bill-source-native" name="billSource" data-bill-source tabindex="-1" aria-hidden="true">
						<option value="">Sin indicar</option>
						<option value="whatsapp">WhatsApp</option>
						<option value="mail">Mail</option>
						<option value="other">Otro</option>
					</select>
				</div>
			) : null}

			{requireAttachment ? (
				<label class="sg-order-attachment">
					<span>Comprobante (PDF, JPG o PNG) *</span>
					<span class="sg-order-attachment-control sg-focus-ring">
						<input
							class="sg-order-attachment-native"
							type="file"
							accept="application/pdf,image/jpeg,image/png,.pdf,.jpg,.jpeg,.png"
							data-bill-attachment
						/>
						<span class="sg-order-attachment-cta">Elegir archivo</span>
						<span class="sg-order-attachment-name" data-bill-attachment-name>Sin archivo</span>
					</span>
				</label>
			) : null}

			{suggestLinesFromPdf ? (
				<div class="sg-pdf-suggest" data-pdf-suggest hidden>
					<p class="sg-pdf-suggest-status" data-pdf-suggest-status></p>
					<p class="sg-pdf-suggest-hint" data-pdf-suggest-partner hidden></p>
					<ul class="sg-pdf-suggest-list" data-pdf-suggest-list hidden></ul>
					<button
						class="sg-focus-ring"
						type="button"
						data-pdf-suggest-apply
						hidden
					>
						Usar líneas detectadas
					</button>
				</div>
			) : null}

			<div
				class="sg-order-picker sg-order-picker--partner"
				data-order-picker
				data-picker-kind="partner"
				data-list-key={partnerListKey}
			>
				<label>
					<span>{partnerLabel} *</span>
					<input
						class="sg-focus-ring"
						type="search"
						autocomplete="off"
						placeholder={partnerPlaceholder}
						data-picker-query
						value={initialPartner?.label || ''}
					/>
				</label>
				<input
					type="hidden"
					name="partnerId"
					value={initialPartner?.id ? String(initialPartner.id) : ''}
					required
					data-picker-id
				/>
				<p
					class="sg-order-picker-selected"
					data-picker-selected
					hidden={!initialPartner}
				>
					{initialPartner ? `Elegido: ${initialPartner.label}` : ''}
				</p>
				<p class="sg-order-picker-warn" data-partner-fiscal-warn hidden></p>
				<ul class="sg-order-picker-results" data-picker-results hidden></ul>
			</div>
		</div>

		<div class="sg-order-create-body">
		<fieldset class="sg-order-line-composer" data-line-composer>
			<legend>Agregar línea</legend>
			<div
				class="sg-order-picker"
				data-order-picker
				data-picker-kind="product"
				data-list-key={productListKey}
			>
				<label>
					<span>Producto</span>
					<input
						class="sg-focus-ring"
						type="search"
						autocomplete="off"
						placeholder={productPlaceholder}
						data-picker-query
					/>
				</label>
				<input type="hidden" value="" data-picker-id data-draft-product-id />
				<p class="sg-order-picker-selected" data-picker-selected hidden></p>
				<ul class="sg-order-picker-results" data-picker-results hidden></ul>
			</div>
			<div class="sg-order-line-fields">
				<label>
					<span>Cantidad</span>
					<input class="sg-focus-ring" type="number" min="0.01" step="any" value="1" data-draft-qty />
				</label>
				<label>
					<span>Precio</span>
					<input class="sg-focus-ring" type="number" min="0" step="any" value="" placeholder="Lista" data-draft-price />
				</label>
				<label>
					<span>% Desc.</span>
					<input class="sg-focus-ring" type="number" min="0" max="100" step="any" value="0" data-draft-discount />
				</label>
			</div>
			<button class="sg-focus-ring" type="button" data-add-line>Agregar línea</button>
		</fieldset>

		<div class="sg-order-lines" data-order-lines>
			<p class="sg-order-lines-empty" data-lines-empty>Sin líneas todavía.</p>
			<ul data-lines-list hidden></ul>
		</div>
		</div>

		<div class="sg-order-create-actions">
			<button class="sg-focus-ring" type="submit">{submitLabel}</button>
			<a class="sg-focus-ring" href={cancelPath}>Cancelar</a>
			<span class="sg-order-create-status" data-order-create-status hidden></span>
		</div>
	</form>
</section>

<script
	define:vars={{
		apiPath,
		listPath,
		formAction,
		recordId,
		initialLines,
		pendingLabel,
		successLabel,
		isUpdate,
	}}
>
	const root = document.querySelector('[data-order-create]');
	const form = root?.querySelector('[data-order-create-form]');
	const status = root?.querySelector('[data-order-create-status]');
	const linesEmpty = root?.querySelector('[data-lines-empty]');
	const linesList = root?.querySelector('[data-lines-list]');
	const addLineBtn = root?.querySelector('[data-add-line]');
	const draftProductId = root?.querySelector('[data-draft-product-id]');
	const draftQty = root?.querySelector('[data-draft-qty]');
	const draftPrice = root?.querySelector('[data-draft-price]');
	const draftDiscount = root?.querySelector('[data-draft-discount]');
	/** @type {{ productId: number, label: string, qty: number, price?: number, discount?: number }[]} */
	let lines = Array.isArray(initialLines)
		? initialLines.map((line) => ({ ...line }))
		: [];
	let draftLabel = '';
	let draftListPrice = null;

	function wireBillSourceSelect(host) {
		const trigger = host.querySelector('[data-bill-source-trigger]');
		const list = host.querySelector('[data-bill-source-list]');
		const label = host.querySelector('[data-bill-source-label]');
		const native = host.querySelector('[data-bill-source]');
		if (
			!(trigger instanceof HTMLButtonElement) ||
			!(list instanceof HTMLElement) ||
			!(label instanceof HTMLElement) ||
			!(native instanceof HTMLSelectElement)
		) {
			return;
		}

		const options = [...list.querySelectorAll('[role="option"]')];

		const setOpen = (open) => {
			list.hidden = !open;
			trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
			host.dataset.open = open ? '1' : '0';
		};

		const choose = (option) => {
			if (!(option instanceof HTMLElement)) return;
			const value = option.getAttribute('data-value') ?? '';
			const text = option.getAttribute('data-label') || option.textContent || '';
			native.value = value;
			label.textContent = text;
			for (const item of options) {
				item.setAttribute(
					'aria-selected',
					item === option ? 'true' : 'false'
				);
			}
			setOpen(false);
			trigger.focus();
		};

		trigger.addEventListener('click', () => {
			setOpen(list.hidden);
		});

		for (const option of options) {
			option.addEventListener('click', () => choose(option));
			option.addEventListener('keydown', (event) => {
				if (!(option instanceof HTMLElement)) return;
				if (event.key === 'Enter' || event.key === ' ') {
					event.preventDefault();
					choose(option);
					return;
				}
				if (event.key === 'Escape') {
					event.preventDefault();
					setOpen(false);
					trigger.focus();
					return;
				}
				const index = options.indexOf(option);
				if (event.key === 'ArrowDown' && index < options.length - 1) {
					event.preventDefault();
					options[index + 1]?.focus();
				}
				if (event.key === 'ArrowUp' && index > 0) {
					event.preventDefault();
					options[index - 1]?.focus();
				}
			});
		}

		trigger.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowDown' || event.key === 'Enter' || event.key === ' ') {
				event.preventDefault();
				setOpen(true);
				const selected =
					list.querySelector('[aria-selected="true"]') || options[0];
				if (selected instanceof HTMLElement) selected.focus();
			}
			if (event.key === 'Escape') setOpen(false);
		});

		document.addEventListener('click', (event) => {
			if (!(event.target instanceof Node) || host.contains(event.target)) return;
			setOpen(false);
		});
	}

	const billSourceHost = root?.querySelector('[data-bill-source-select]');
	if (billSourceHost instanceof HTMLElement) wireBillSourceSelect(billSourceHost);

	const billAttachment = root?.querySelector('[data-bill-attachment]');
	const billAttachmentName = root?.querySelector('[data-bill-attachment-name]');
	const pdfSuggest = root?.querySelector('[data-pdf-suggest]');
	const pdfSuggestStatus = root?.querySelector('[data-pdf-suggest-status]');
	const pdfSuggestPartner = root?.querySelector('[data-pdf-suggest-partner]');
	const pdfSuggestList = root?.querySelector('[data-pdf-suggest-list]');
	const pdfSuggestApply = root?.querySelector('[data-pdf-suggest-apply]');
	/** @type {Array<{ status: string, reason: string, productId: number | null, code: string, name: string, qty: number, price: number }>} */
	let pendingPdfLines = [];

	function setPdfSuggestStatus(text, state) {
		if (!(pdfSuggest instanceof HTMLElement) || !(pdfSuggestStatus instanceof HTMLElement)) {
			return;
		}
		if (!text) {
			pdfSuggest.hidden = true;
			pdfSuggestStatus.textContent = '';
			pdfSuggestStatus.dataset.state = '';
			return;
		}
		pdfSuggest.hidden = false;
		pdfSuggestStatus.textContent = text;
		pdfSuggestStatus.dataset.state = state || '';
	}

	function renderPdfReviewList() {
		if (!(pdfSuggestList instanceof HTMLElement)) return;
		pdfSuggestList.replaceChildren();
		const review = pendingPdfLines.filter((l) => l.status === 'review');
		if (!review.length) {
			pdfSuggestList.hidden = true;
			return;
		}
		pdfSuggestList.hidden = false;
		review.forEach((row) => {
			const li = document.createElement('li');
			li.textContent = `${row.code || '—'} · ${row.name || 'sin nombre'} · cant ${row.qty} · $${row.price}`;
			const pick = document.createElement('button');
			pick.type = 'button';
			pick.className = 'sg-focus-ring';
			pick.textContent = 'Elegir producto';
			pick.addEventListener('click', () => {
				if (draftQty instanceof HTMLInputElement) draftQty.value = String(row.qty);
				if (draftPrice instanceof HTMLInputElement) draftPrice.value = String(row.price);
				const productPicker = root?.querySelector('[data-picker-kind="product"]');
				const q = productPicker?.querySelector('[data-picker-query]');
				if (q instanceof HTMLInputElement) {
					q.value = row.code || row.name || '';
					q.focus();
					q.dispatchEvent(new Event('input', { bubbles: true }));
				}
				pendingPdfLines = pendingPdfLines.filter((l) => l !== row);
				renderPdfReviewList();
			});
			const discard = document.createElement('button');
			discard.type = 'button';
			discard.className = 'sg-focus-ring';
			discard.textContent = 'Descartar';
			discard.addEventListener('click', () => {
				pendingPdfLines = pendingPdfLines.filter((l) => l !== row);
				renderPdfReviewList();
			});
			li.appendChild(pick);
			li.appendChild(discard);
			pdfSuggestList.appendChild(li);
		});
	}

	function applyMatchedPdfLines() {
		const matched = pendingPdfLines.filter(
			(l) => l.status === 'matched' && Number(l.productId) > 0
		);
		for (const row of matched) {
			const already = lines.some(
				(l) => l.productId === row.productId && l.qty === row.qty && l.price === row.price
			);
			if (already) continue;
			lines.push({
				productId: Number(row.productId),
				label: row.code ? `[${row.code}] ${row.name}` : row.name || String(row.productId),
				qty: row.qty,
				price: row.price,
			});
		}
		pendingPdfLines = pendingPdfLines.filter((l) => l.status !== 'matched');
		renderLines();
		renderPdfReviewList();
		if (pdfSuggestApply instanceof HTMLButtonElement) {
			pdfSuggestApply.hidden = true;
		}
	}

	async function maybeParseVendorBillPdf(file) {
		if (root?.getAttribute('data-suggest-pdf') !== '1') return;
		if (!(file instanceof File)) return;
		const isPdf =
			file.type === 'application/pdf' || /\.pdf$/i.test(file.name || '');
		if (!isPdf) {
			pendingPdfLines = [];
			if (pdfSuggestPartner instanceof HTMLElement) pdfSuggestPartner.hidden = true;
			if (pdfSuggestList instanceof HTMLElement) pdfSuggestList.hidden = true;
			if (pdfSuggestApply instanceof HTMLButtonElement) pdfSuggestApply.hidden = true;
			setPdfSuggestStatus('', '');
			return;
		}
		setPdfSuggestStatus('Leyendo comprobante…', 'pending');
		if (pdfSuggestApply instanceof HTMLButtonElement) pdfSuggestApply.hidden = true;
		try {
			const content = await readFileAsDataUrl(file);
			const response = await fetch('/api/accounting/vendor-bill-parse', {
				method: 'POST',
				credentials: 'same-origin',
				headers: { 'content-type': 'application/json' },
				body: JSON.stringify({ filename: file.name, content }),
			});
			const payload = await response.json().catch(() => ({}));
			if (response.status === 401) {
				window.location.assign('/login');
				return;
			}
			if (!response.ok) {
				throw new Error(payload?.error?.message || 'No se pudo leer el PDF');
			}
			pendingPdfLines = Array.isArray(payload.lines) ? payload.lines : [];
			const matched = Number(payload.counts?.matched || 0);
			const review = Number(payload.counts?.review || 0);
			const error = Number(payload.counts?.error || 0);
			if (pdfSuggestPartner instanceof HTMLElement) {
				const vat = payload.partnerHint?.vat;
				if (vat) {
					pdfSuggestPartner.hidden = false;
					pdfSuggestPartner.textContent = `CUIT detectado: ${vat}${
						payload.partnerHint?.name ? ` · ${payload.partnerHint.name}` : ''
					}`;
				} else {
					pdfSuggestPartner.hidden = true;
					pdfSuggestPartner.textContent = '';
				}
			}
			if (!pendingPdfLines.length) {
				setPdfSuggestStatus(
					'No se pudieron leer líneas de este PDF. Agregálas a mano.',
					'muted'
				);
				renderPdfReviewList();
				return;
			}
			setPdfSuggestStatus(
				`Detectamos ${matched} listas · ${review} a revisar · ${error} error. Revisá antes de crear el borrador.`,
				'ok'
			);
			if (matched > 0 && pdfSuggestApply instanceof HTMLButtonElement) {
				pdfSuggestApply.hidden = false;
			}
			renderPdfReviewList();
			// Auto-apply matched so the form is usable immediately
			if (matched > 0) applyMatchedPdfLines();
		} catch (error) {
			setPdfSuggestStatus(
				error instanceof Error
					? error.message
					: 'No se pudieron leer líneas de este PDF. Agregálas a mano.',
				'error'
			);
		}
	}

	if (
		billAttachment instanceof HTMLInputElement &&
		billAttachmentName instanceof HTMLElement
	) {
		billAttachment.addEventListener('change', () => {
			const file = billAttachment.files?.[0];
			billAttachmentName.textContent = file?.name || 'Sin archivo';
			billAttachmentName.dataset.state = file ? 'ready' : 'empty';
			void maybeParseVendorBillPdf(file || null);
		});
	}

	if (pdfSuggestApply instanceof HTMLButtonElement) {
		pdfSuggestApply.addEventListener('click', () => applyMatchedPdfLines());
	}

	function buildSearchUrl(listKey, q) {
		const query = String(q || '').trim();
		if (!listKey || !query) return null;
		const params = new URLSearchParams({ q: query, page: '1' });
		return `/api/lists/${listKey}?${params.toString()}`;
	}

	function labelPartner(row) {
		const name =
			typeof row?.name === 'string' && row.name.trim()
				? row.name.trim()
				: String(row?.id ?? '');
		if (root?.getAttribute('data-suppress-fiscal') === '1') return name;
		const dest = String(row?.sg_invoice_dest || '').toLowerCase();
		if (dest === 'cuit') return `${name} · CUIT`;
		if (dest === 'cf') return `${name} · CF`;
		return name;
	}

	function suggestedDocLabel(dest) {
		return String(dest || '').toLowerCase() === 'cuit'
			? 'Factura A/B (CUIT)'
			: 'Factura B/C (consumidor final)';
	}

	function setPartnerFiscalWarn(row) {
		const warn = root?.querySelector('[data-partner-fiscal-warn]');
		if (!(warn instanceof HTMLElement)) return;
		if (root?.getAttribute('data-suppress-fiscal') === '1') {
			warn.hidden = true;
			warn.textContent = '';
			return;
		}
		if (!row) {
			warn.hidden = true;
			warn.textContent = '';
			return;
		}
		const dest = String(row?.sg_invoice_dest || 'cf').toLowerCase();
		const vat = String(row?.vat || '').trim();
		const parts = [
			`Tipo sugerido: ${suggestedDocLabel(dest)}.`,
			'Sugerido según destino. El tipo final lo define AFIP/l10n_ar según tu condición IVA.',
		];
		const missingCuit = dest === 'cuit' && !vat;
		if (missingCuit) {
			parts.unshift('Falta CUIT; completá la ficha antes de facturar.');
		}
		warn.hidden = false;
		warn.dataset.state = missingCuit ? 'warn' : 'info';
		warn.textContent = parts.join(' ');
	}

	function readFileAsDataUrl(file) {
		return new Promise((resolve, reject) => {
			const reader = new FileReader();
			reader.onload = () => resolve(String(reader.result || ''));
			reader.onerror = () => reject(new Error('No se pudo leer el archivo'));
			reader.readAsDataURL(file);
		});
	}

	function labelProduct(row) {
		const display = row?.display_name;
		if (typeof display === 'string' && display.trim()) return display.trim();
		const code = row?.default_code;
		if (typeof code === 'string' && code.trim()) return code.trim();
		const name = row?.name;
		if (typeof name === 'string' && name.trim()) return name.trim();
		return String(row?.id ?? '');
	}

	function renderLines() {
		if (!(linesList instanceof HTMLElement) || !(linesEmpty instanceof HTMLElement)) return;
		linesList.replaceChildren();
		if (!lines.length) {
			linesEmpty.hidden = false;
			linesList.hidden = true;
			return;
		}
		linesEmpty.hidden = true;
		linesList.hidden = false;
		lines.forEach((line, index) => {
			const li = document.createElement('li');
			const meta = [
				`x${line.qty}`,
				line.price != null ? `$${line.price}` : 'precio lista',
				line.discount ? `-${line.discount}%` : null,
			]
				.filter(Boolean)
				.join(' · ');
			li.innerHTML = `<strong></strong><span></span>`;
			const strong = li.querySelector('strong');
			const span = li.querySelector('span');
			if (strong) strong.textContent = line.label;
			if (span) span.textContent = meta;
			const remove = document.createElement('button');
			remove.type = 'button';
			remove.className = 'sg-focus-ring';
			remove.textContent = 'Quitar';
			remove.addEventListener('click', () => {
				lines = lines.filter((_, i) => i !== index);
				renderLines();
			});
			li.appendChild(remove);
			linesList.appendChild(li);
		});
	}

	function wirePicker(picker) {
		const listKey = picker.getAttribute('data-list-key') || '';
		const kind = picker.getAttribute('data-picker-kind') || 'partner';
		const queryInput = picker.querySelector('[data-picker-query]');
		const idInput = picker.querySelector('[data-picker-id]');
		const selectedEl = picker.querySelector('[data-picker-selected]');
		const resultsEl = picker.querySelector('[data-picker-results]');
		if (
			!(queryInput instanceof HTMLInputElement) ||
			!(idInput instanceof HTMLInputElement) ||
			!(selectedEl instanceof HTMLElement) ||
			!(resultsEl instanceof HTMLElement)
		) {
			return;
		}

		let timer = 0;
		let seq = 0;

		const clearSelection = () => {
			idInput.value = '';
			selectedEl.hidden = true;
			selectedEl.textContent = '';
			if (kind === 'partner') setPartnerFiscalWarn(null);
			if (kind === 'product') {
				draftLabel = '';
				draftListPrice = null;
			}
		};

		const hideResults = () => {
			resultsEl.hidden = true;
			resultsEl.replaceChildren();
		};

		const choose = (id, label, row) => {
			idInput.value = String(id);
			selectedEl.hidden = false;
			selectedEl.textContent = `Elegido: ${label}`;
			queryInput.value = label;
			hideResults();
			if (kind === 'partner') setPartnerFiscalWarn(row);
			if (kind === 'product') {
				draftLabel = label;
				const price = Number(row?.list_price);
				draftListPrice = Number.isFinite(price) ? price : null;
				if (
					draftPrice instanceof HTMLInputElement &&
					draftListPrice != null &&
					!draftPrice.value
				) {
					draftPrice.value = String(draftListPrice);
				}
			}
		};

		const renderResults = (rows) => {
			resultsEl.replaceChildren();
			const labeler = kind === 'product' ? labelProduct : labelPartner;
			for (const row of rows || []) {
				const id = Number(row.id);
				if (!Number.isFinite(id) || id <= 0) continue;
				const label = labeler(row);
				const li = document.createElement('li');
				const btn = document.createElement('button');
				btn.type = 'button';
				btn.className = 'sg-focus-ring';
				btn.textContent = label;
				btn.addEventListener('click', () => choose(id, label, row));
				li.appendChild(btn);
				resultsEl.appendChild(li);
			}
			resultsEl.hidden = resultsEl.childElementCount === 0;
			if (resultsEl.hidden) {
				const empty = document.createElement('li');
				empty.className = 'sg-order-picker-empty';
				empty.textContent = 'Sin resultados';
				resultsEl.appendChild(empty);
				resultsEl.hidden = false;
			}
		};

		const search = async () => {
			const url = buildSearchUrl(listKey, queryInput.value);
			if (!url) {
				hideResults();
				return;
			}
			const mySeq = ++seq;
			try {
				const response = await fetch(url, { credentials: 'same-origin' });
				const payload = await response.json().catch(() => ({}));
				if (mySeq !== seq) return;
				if (!response.ok) {
					hideResults();
					return;
				}
				renderResults(payload.rows || []);
			} catch {
				if (mySeq === seq) hideResults();
			}
		};

		queryInput.addEventListener('input', () => {
			clearSelection();
			window.clearTimeout(timer);
			timer = window.setTimeout(search, 250);
		});

		queryInput.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') hideResults();
		});
	}

	root?.querySelectorAll('[data-order-picker]').forEach((picker) => {
		if (picker instanceof HTMLElement) wirePicker(picker);
	});

	addLineBtn?.addEventListener('click', () => {
		const productId = Number(
			draftProductId instanceof HTMLInputElement ? draftProductId.value : 0
		);
		const qty = Number(draftQty instanceof HTMLInputElement ? draftQty.value : 0);
		const priceRaw =
			draftPrice instanceof HTMLInputElement ? draftPrice.value.trim() : '';
		const discount = Number(
			draftDiscount instanceof HTMLInputElement ? draftDiscount.value : 0
		);
		if (!productId || !draftLabel || !Number.isFinite(qty) || qty <= 0) {
			if (status instanceof HTMLElement) {
				status.hidden = false;
				status.textContent = 'Elegí un producto y cantidad válidos';
				status.dataset.state = 'error';
			}
			return;
		}
		if (!Number.isFinite(discount) || discount < 0 || discount > 100) {
			if (status instanceof HTMLElement) {
				status.hidden = false;
				status.textContent = 'El descuento debe estar entre 0 y 100';
				status.dataset.state = 'error';
			}
			return;
		}
		/** @type {{ productId: number, label: string, qty: number, price?: number, discount?: number }} */
		const line = { productId, label: draftLabel, qty };
		if (priceRaw !== '') {
			const price = Number(priceRaw);
			if (!Number.isFinite(price) || price < 0) {
				if (status instanceof HTMLElement) {
					status.hidden = false;
					status.textContent = 'Precio inválido';
					status.dataset.state = 'error';
				}
				return;
			}
			line.price = price;
		}
		if (discount > 0) line.discount = discount;
		lines.push(line);
		renderLines();
		if (draftProductId instanceof HTMLInputElement) draftProductId.value = '';
		draftLabel = '';
		const productPicker = root?.querySelector('[data-picker-kind="product"]');
		const q = productPicker?.querySelector('[data-picker-query]');
		const sel = productPicker?.querySelector('[data-picker-selected]');
		if (q instanceof HTMLInputElement) q.value = '';
		if (sel instanceof HTMLElement) {
			sel.hidden = true;
			sel.textContent = '';
		}
		if (draftQty instanceof HTMLInputElement) draftQty.value = '1';
		if (draftPrice instanceof HTMLInputElement) draftPrice.value = '';
		if (draftDiscount instanceof HTMLInputElement) draftDiscount.value = '0';
		if (status instanceof HTMLElement) status.hidden = true;
	});

	if (form instanceof HTMLFormElement && status instanceof HTMLElement) {
		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			status.hidden = false;
			status.textContent = pendingLabel || 'Creando…';
			status.dataset.state = 'pending';
			const data = new FormData(form);
			const partnerId = Number(data.get('partnerId'));
			if (!partnerId) {
				status.textContent = 'Elegí un contacto de la lista';
				status.dataset.state = 'error';
				return;
			}
			if (!lines.length) {
				status.textContent = 'Agregá al menos una línea';
				status.dataset.state = 'error';
				return;
			}
			const values = {
				partnerId,
				lines: lines.map(({ productId, qty, price, discount }) => {
					const line = { productId, qty };
					if (price != null) line.price = price;
					if (discount != null) line.discount = discount;
					return line;
				}),
			};
			const billSource = data.get('billSource');
			if (typeof billSource === 'string' && billSource.trim()) {
				values.billSource = billSource.trim();
			}
			if (root?.getAttribute('data-require-attachment') === '1' && !isUpdate) {
				const fileInput = root.querySelector('[data-bill-attachment]');
				const file =
					fileInput instanceof HTMLInputElement && fileInput.files?.length
						? fileInput.files[0]
						: null;
				if (!file) {
					status.textContent = 'Adjuntá el PDF o la foto del comprobante';
					status.dataset.state = 'error';
					return;
				}
				if (file.size > 10 * 1024 * 1024) {
					status.textContent = 'El archivo es demasiado grande (máx. 10 MB).';
					status.dataset.state = 'error';
					return;
				}
				try {
					const content = await readFileAsDataUrl(file);
					values.attachment = {
						filename: file.name || 'comprobante',
						mimetype: file.type || '',
						content,
					};
				} catch {
					status.textContent = 'No se pudo leer el archivo';
					status.dataset.state = 'error';
					return;
				}
			}
			try {
				const body =
					isUpdate && formAction === 'update_invoice_draft'
						? {
								action: 'update_invoice_draft',
								id: Number(recordId),
								values,
							}
						: { action: 'create', values };
				const response = await fetch(apiPath, {
					method: 'POST',
					credentials: 'same-origin',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify(body),
				});
				const payload = await response.json().catch(() => ({}));
				if (!response.ok) {
					throw new Error(
						payload?.error?.message ||
							(isUpdate ? 'No se pudo guardar' : 'No se pudo crear')
					);
				}
				status.textContent = successLabel || (isUpdate ? 'Guardado' : 'Creada');
				status.dataset.state = 'ok';
				window.setTimeout(() => {
					window.location.href = payload.detailPath || listPath;
				}, 350);
			} catch (error) {
				status.textContent =
					error instanceof Error
						? error.message
						: isUpdate
							? 'No se pudo guardar'
							: 'No se pudo crear';
				status.dataset.state = 'error';
			}
		});
	}

	renderLines();
</script>

